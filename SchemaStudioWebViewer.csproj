<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <PackageReference Include="Radzen.Blazor" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Components\Fragments\" />
    <Folder Include="WEBSemanticModel\" />
    <Folder Include="WEBSemanticModel\Binding\" />
    <Folder Include="WEBSemanticModel\Diagnostics\" />
    <Folder Include="WEBSemanticModel\DTO\" />
    <Folder Include="WEBSemanticModel\Model\" />
    <Folder Include="WEBSemanticModel\Orchestration\" />
    <Folder Include="WEBSemanticModel\Parsing\" />
    <Folder Include="WEBSemanticModel\Providers\" />
    <Folder Include="WEBSemanticModel\Services\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SchemaStudio.AIHelpers\SchemaStudio.AIHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SchemaStudio.AIHelpers\**\*.cs" />
    <Content Remove="SchemaStudio.AIHelpers\**\*" />
    <EmbeddedResource Remove="SchemaStudio.AIHelpers\**\*" />
    <None Remove="SchemaStudio.AIHelpers\**\*" />
  </ItemGroup>

  <!-- AI 2026-04-15 10:36: restored post-build Git checkpoint hook for build snapshots. -->
  <Target Name="PostBuildGitCheckpoint" AfterTargets="Build">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\post-build-git-checkpoint.ps1&quot; -CommitMessage &quot;Checkpoint successful build SchemaStudioWebViewer&quot;" />
  </Target>

</Project>
