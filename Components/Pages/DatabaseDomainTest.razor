@page "/database-domain-test"

@using Radzen
@using Radzen.Blazor
@using SchemaStudio.Data.Models


<PageTitle>Database Domain Repository Test</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H4">Database Domain Repository Test</RadzenText>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenLabel Text="Target Database" Component="DatabaseSelector" />
        <RadzenDropDown @bind-Value="SelectedDatabaseId"
                        Data="Databases"
                        TextProperty="DatabaseName"
                        ValueProperty="DatabaseId"
                        Name="DatabaseSelector"
                        Style="width: 320px;" />
        <RadzenButton Text="Run Repository Test" Click="@RunTestAsync" Disabled="@IsRunning" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1">@StatusMessage</RadzenText>

    <RadzenDataGrid Data="Domains" TItem="DatabaseDomainDefinition" AllowPaging="true" PageSize="25">
        <Columns>
            <RadzenDataGridColumn TItem="DatabaseDomainDefinition" Property="DatabaseDomainId" Title="Id" Width="100px" />
            <RadzenDataGridColumn TItem="DatabaseDomainDefinition" Property="Domain" Title="Domain" />
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
