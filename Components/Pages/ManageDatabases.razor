@page "/manage-databases"
@using Microsoft.Data.SqlClient
@inject DatabaseRepository DatabaseRepository
@inject DatabaseDomainRepository DomainRepository
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Manage Databases</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Gap="1rem">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Manage Databases</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Style="color:#495057;">
                Create and edit database records and their business domains.
            </RadzenText>
        </RadzenStack>

        <RadzenButton Icon="add"
                      Text="New Database"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@OpenNewDatabaseDialog" />
    </RadzenStack>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            @loadError
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeLG="5">
            @if (databases.Count == 0 && !isLoading)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                    No databases exist yet. Use New Database to create the first one.
                </RadzenAlert>
            }
            else
            {
                <RadzenDataGrid Data="@databases"
                                TItem="DatabaseDefinition"
                                AllowFiltering="true"
                                AllowSorting="true"
                                AllowPaging="true"
                                PageSize="12"
                                SelectionMode="DataGridSelectionMode.Single"
                                @bind-Value="@selectedDatabases"
                                RowSelect="@SelectDatabase"
                                Style="height: calc(100vh - 210px);">
                    <Columns>
                        <RadzenDataGridColumn TItem="DatabaseDefinition" Property="DatabaseName" Title="Database" />
                        <RadzenDataGridColumn TItem="DatabaseDefinition" Property="BusinessName" Title="Business Name" />
                        <RadzenDataGridColumn TItem="DatabaseDefinition" Property="Active" Title="Active" Width="90px">
                            <Template Context="database">
                                <RadzenCheckBox Value="@database.Active" Disabled="true" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="7">
            @if (selectedDatabase is null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                    No database is selected. Create a database to begin maintaining domains.
                </RadzenAlert>
            }
            else
            {
                <RadzenTabs @bind-SelectedIndex="@selectedTabIndex">
                    <Tabs>
                        <RadzenTabsItem Text="Database" Icon="database">
                            <RadzenTemplateForm TItem="DatabaseDefinition"
                                                Data="@editDatabase"
                                                Submit="@SaveDatabase">
                                <DataAnnotationsValidator />
                                <RadzenStack Gap="0.25rem" class="rz-px-4 rz-pt-4">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">Edit Selected Database</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2" Style="color:#495057;">@selectedDatabase.DatabaseName</RadzenText>
                                </RadzenStack>
                                @DatabaseFormFields(editDatabase)

                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" class="rz-px-4 rz-pb-4">
                                    <RadzenButton Icon="refresh" Text="Reset" ButtonStyle="ButtonStyle.Light" Click="@ResetDatabaseEdit" />
                                    <RadzenButton Icon="delete"
                                                  Text="Delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Click="@DeleteDatabase" />
                                    <RadzenButton Icon="save" Text="Save Selected Database" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                                </RadzenStack>
                            </RadzenTemplateForm>
                        </RadzenTabsItem>

                        <RadzenTabsItem Text="Domains" Icon="category">
                            <RadzenStack Gap="1rem" class="rz-p-4">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween"
                                             Gap="1rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">
                                        @selectedDatabase.DatabaseName Domains
                                    </RadzenText>

                                    <RadzenButton Icon="add"
                                                  Text="Add Domain"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Click="@OpenNewDomainDialog" />
                                </RadzenStack>

                                @if (domains.Count == 0)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                        This database does not have any domains yet. Use Add Domain to create the first one.
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenDataGrid Data="@domains"
                                                    TItem="DatabaseDomainDefinition"
                                                    AllowSorting="true"
                                                    SelectionMode="DataGridSelectionMode.Single"
                                                    @bind-Value="@selectedDomains"
                                                    RowSelect="@SelectDomain"
                                                    Style="height: 220px;">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="DatabaseDomainDefinition" Property="Domain" Title="Domain" />
                                            <RadzenDataGridColumn TItem="DatabaseDomainDefinition" Property="Description" Title="Description" />
                                        </Columns>
                                    </RadzenDataGrid>
                                }

                                @if (selectedDomain is null)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
                                        Select a domain to edit it.
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenTemplateForm TItem="DatabaseDomainDefinition"
                                                        Data="@editDomain"
                                                        Submit="@SaveDomain">
                                        <DataAnnotationsValidator />
                                        <RadzenStack Gap="0.25rem">
                                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">Edit Selected Domain</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Body2" Style="color:#495057;">@editDomain.Domain</RadzenText>
                                        </RadzenStack>
                                        @DomainFormFields(editDomain)

                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
                                            <RadzenButton Icon="refresh" Text="Reset" ButtonStyle="ButtonStyle.Light" Click="@ResetDomainEdit" />
                                            <RadzenButton Icon="save" Text="Save Selected Domain" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                                        </RadzenStack>
                                    </RadzenTemplateForm>
                                }
                            </RadzenStack>
                        </RadzenTabsItem>
                    </Tabs>
                </RadzenTabs>
            }
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@if (isNewDatabaseDialogOpen)
{
    <div class="database-modal-backdrop">
        <RadzenCard class="database-modal rz-p-0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         class="rz-p-4 rz-border-bottom">
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">New Database</RadzenText>
                <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="@CloseNewDatabaseDialog" />
            </RadzenStack>

            <RadzenTemplateForm TItem="DatabaseDefinition"
                                Data="@newDatabase"
                                Submit="@CreateDatabase">
                <DataAnnotationsValidator />
                @DatabaseFormFields(newDatabase)

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" class="rz-px-4 rz-pb-4">
                    <RadzenButton Icon="close" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseNewDatabaseDialog" />
                    <RadzenButton Icon="save" Text="Create Database" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    </div>
}

@if (isNewDomainDialogOpen && selectedDatabase is not null)
{
    <div class="database-modal-backdrop">
        <RadzenCard class="database-modal rz-p-0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         class="rz-p-4 rz-border-bottom">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Add Domain</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="color:#495057;">@selectedDatabase.DatabaseName</RadzenText>
                </RadzenStack>
                <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="@CloseNewDomainDialog" />
            </RadzenStack>

            <RadzenTemplateForm TItem="DatabaseDomainDefinition"
                                Data="@newDomain"
                                Submit="@CreateDomain">
                <DataAnnotationsValidator />
                <RadzenStack Gap="1rem" class="rz-p-4">
                    @DomainFormFields(newDomain)
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" class="rz-px-4 rz-pb-4">
                    <RadzenButton Icon="close" Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@CloseNewDomainDialog" />
                    <RadzenButton Icon="save" Text="Create Domain" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>
    </div>
}

<style>
    .database-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 8vh 1rem 1rem;
        background: rgba(33, 37, 41, 0.35);
    }

    .database-modal {
        width: min(760px, calc(100vw - 2rem));
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        border-radius: 8px;
    }
</style>

@code {
    private List<DatabaseDefinition> databases = new();
    private IList<DatabaseDefinition> selectedDatabases = new List<DatabaseDefinition>();
    private List<DatabaseDomainDefinition> domains = new();
    private IList<DatabaseDomainDefinition> selectedDomains = new List<DatabaseDomainDefinition>();
    private DatabaseDefinition editDatabase = NewDatabaseDefinition();
    private DatabaseDefinition newDatabase = NewDatabaseDefinition();
    private DatabaseDefinition? selectedDatabase;
    private DatabaseDomainDefinition editDomain = new();
    private DatabaseDomainDefinition newDomain = new();
    private DatabaseDomainDefinition? selectedDomain;
    private bool isLoading;
    private bool isNewDatabaseDialogOpen;
    private bool isNewDomainDialogOpen;
    private int selectedTabIndex;
    private string loadError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDatabasesAsync(selectFirstWhenMissing: true);
    }

    private async Task LoadDatabasesAsync(bool selectFirstWhenMissing = false)
    {
        isLoading = true;
        loadError = "";

        try
        {
            databases = (await DatabaseRepository.GetAllAsync()).ToList();

            if (selectedDatabase is not null)
            {
                selectedDatabase = databases.FirstOrDefault(x => x.DatabaseId == selectedDatabase.DatabaseId);
            }

            if (selectedDatabase is null && selectFirstWhenMissing)
            {
                selectedDatabase = databases.FirstOrDefault();
            }

            if (selectedDatabase is not null)
            {
                selectedDatabases = new List<DatabaseDefinition> { selectedDatabase };
                editDatabase = Clone(selectedDatabase);
                await LoadDomainsAsync(selectedDatabase.DatabaseId);
            }
            else
            {
                ClearDatabaseSelection();
            }
        }
        catch (Exception ex)
        {
            loadError = FriendlyError(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDomainsAsync(int databaseId)
    {
        try
        {
            domains = (await DomainRepository.GetByDatabaseIdAsync(databaseId)).ToList();
            selectedDomain = domains.FirstOrDefault(x => selectedDomain is not null && x.DatabaseDomainId == selectedDomain.DatabaseDomainId);
            selectedDomain ??= domains.FirstOrDefault();

            if (selectedDomain is not null)
            {
                selectedDomains = new List<DatabaseDomainDefinition> { selectedDomain };
                editDomain = Clone(selectedDomain);
            }
            else
            {
                selectedDomains.Clear();
                editDomain = new DatabaseDomainDefinition { DatabaseId = databaseId };
            }
        }
        catch (Exception ex)
        {
            domains.Clear();
            selectedDomain = null;
            selectedDomains.Clear();
            editDomain = new DatabaseDomainDefinition { DatabaseId = databaseId };
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private async Task SelectDatabase(DatabaseDefinition database)
    {
        selectedDatabase = database;
        editDatabase = Clone(database);
        selectedDomain = null;
        selectedTabIndex = 0;
        await LoadDomainsAsync(database.DatabaseId);
    }

    private void ClearDatabaseSelection()
    {
        selectedDatabase = null;
        selectedDatabases.Clear();
        domains.Clear();
        selectedDomain = null;
        selectedDomains.Clear();
        editDatabase = NewDatabaseDefinition();
        editDomain = new DatabaseDomainDefinition();
        newDomain = new DatabaseDomainDefinition();
        isNewDomainDialogOpen = false;
    }

    private void OpenNewDatabaseDialog()
    {
        newDatabase = NewDatabaseDefinition();
        isNewDatabaseDialogOpen = true;
    }

    private void CloseNewDatabaseDialog()
    {
        isNewDatabaseDialogOpen = false;
    }

    private void ResetDatabaseEdit()
    {
        editDatabase = selectedDatabase is null
            ? NewDatabaseDefinition()
            : Clone(selectedDatabase);
    }

    private async Task CreateDatabase(DatabaseDefinition database)
    {
        try
        {
            await DatabaseRepository.CreateAsync(database);
            Notify(NotificationSeverity.Success, "Database created.");
            selectedDatabase = database;
            isNewDatabaseDialogOpen = false;
            await LoadDatabasesAsync();
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private async Task SaveDatabase(DatabaseDefinition database)
    {
        try
        {
            await DatabaseRepository.UpdateAsync(database);
            Notify(NotificationSeverity.Success, "Database updated.");
            selectedDatabase = database;
            await LoadDatabasesAsync();
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private async Task DeleteDatabase()
    {
        if (editDatabase.DatabaseId == 0)
            return;

        var confirmed = await DialogService.Confirm(
            "Delete this database? The database constraints will also delete all domains and schema objects within this database.",
            "Delete Database",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed != true)
            return;

        try
        {
            await DatabaseRepository.DeleteAsync(editDatabase.DatabaseId);
            Notify(NotificationSeverity.Success, "Database deleted.");
            selectedDatabase = null;
            await LoadDatabasesAsync(selectFirstWhenMissing: true);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private void SelectDomain(DatabaseDomainDefinition domain)
    {
        selectedDomain = domain;
        editDomain = Clone(domain);
    }

    private void OpenNewDomainDialog()
    {
        if (selectedDatabase is null)
            return;

        newDomain = new DatabaseDomainDefinition
        {
            DatabaseId = selectedDatabase.DatabaseId
        };
        isNewDomainDialogOpen = true;
    }

    private void CloseNewDomainDialog()
    {
        isNewDomainDialogOpen = false;
    }

    private void ResetDomainEdit()
    {
        editDomain = selectedDomain is null
            ? new DatabaseDomainDefinition { DatabaseId = selectedDatabase?.DatabaseId ?? 0 }
            : Clone(selectedDomain);
    }

    private async Task SaveDomain(DatabaseDomainDefinition domain)
    {
        if (selectedDatabase is null)
            return;

        domain.DatabaseId = selectedDatabase.DatabaseId;

        if (HasDuplicateDomain(domain))
        {
            Notify(NotificationSeverity.Warning, "That domain already exists for this database. Domain names must be unique, ignoring case.");
            return;
        }

        try
        {
            if (domain.DatabaseDomainId == 0)
            {
                await DomainRepository.CreateAsync(domain);
                Notify(NotificationSeverity.Success, "Domain created.");
            }
            else
            {
                await DomainRepository.UpdateAsync(domain);
                Notify(NotificationSeverity.Success, "Domain updated.");
            }

            selectedDomain = domain;
            await LoadDomainsAsync(selectedDatabase.DatabaseId);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private async Task CreateDomain(DatabaseDomainDefinition domain)
    {
        if (selectedDatabase is null)
            return;

        domain.DatabaseId = selectedDatabase.DatabaseId;

        if (HasDuplicateDomain(domain))
        {
            Notify(NotificationSeverity.Warning, "That domain already exists for this database. Domain names must be unique, ignoring case.");
            return;
        }

        try
        {
            await DomainRepository.CreateAsync(domain);
            Notify(NotificationSeverity.Success, "Domain created.");
            selectedDomain = domain;
            isNewDomainDialogOpen = false;
            await LoadDomainsAsync(selectedDatabase.DatabaseId);
        }
        catch (Exception ex)
        {
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
    }

    private RenderFragment DatabaseFormFields(DatabaseDefinition database) => @<RadzenStack Gap="1rem" class="rz-p-4">
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Database Name" Style="width:100%;">
                    <RadzenTextBox Name="DatabaseName" @bind-Value="@database.DatabaseName" Style="width:100%;" MaxLength="128" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="DatabaseName" Text="Database name is required." />
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Default Schema" Style="width:100%;">
                    <RadzenTextBox Name="DefaultSchema" @bind-Value="@database.DefaultSchema" Style="width:100%;" MaxLength="128" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="DefaultSchema" Text="Default schema is required." />
            </RadzenColumn>
        </RadzenRow>

        <RadzenFormField Text="Business Name" Style="width:100%;">
            <RadzenTextBox Name="BusinessName" @bind-Value="@database.BusinessName" Style="width:100%;" MaxLength="128" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="BusinessName" Text="Business name is required." />

        <RadzenFormField Text="Business Description" Style="width:100%;">
            <RadzenTextArea Name="BusinessDescription" @bind-Value="@database.BusinessDescription" Style="width:100%;" Rows="4" MaxLength="500" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="BusinessDescription" Text="Business description is required." />

        <RadzenFormField Text="Developer Notes" Style="width:100%;">
            <RadzenTextArea @bind-Value="@database.DeveloperNotes" Style="width:100%;" Rows="6" MaxLength="4000" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenCheckBox @bind-Value="@database.Active" TValue="bool" />
            <RadzenLabel Text="Active" />
        </RadzenStack>
    </RadzenStack>;

    private RenderFragment DomainFormFields(DatabaseDomainDefinition domain) => @<RadzenStack Gap="1rem">
        <RadzenFormField Text="Domain" Style="width:100%;">
            <RadzenTextBox Name="Domain" @bind-Value="@domain.Domain" Style="width:100%;" MaxLength="128" />
        </RadzenFormField>
        <RadzenRequiredValidator Component="Domain" Text="Domain is required." />

        <RadzenFormField Text="Description" Style="width:100%;">
            <RadzenTextArea @bind-Value="@domain.Description" Style="width:100%;" Rows="4" MaxLength="500" />
        </RadzenFormField>
    </RadzenStack>;

    private static DatabaseDefinition NewDatabaseDefinition() =>
        new()
        {
            DefaultSchema = "dbo",
            Active = true
        };

    private static DatabaseDefinition Clone(DatabaseDefinition database) =>
        new()
        {
            DatabaseId = database.DatabaseId,
            DatabaseName = database.DatabaseName,
            DefaultSchema = database.DefaultSchema,
            BusinessName = database.BusinessName,
            BusinessDescription = database.BusinessDescription,
            DeveloperNotes = database.DeveloperNotes,
            Active = database.Active
        };

    private static DatabaseDomainDefinition Clone(DatabaseDomainDefinition domain) =>
        new()
        {
            DatabaseDomainId = domain.DatabaseDomainId,
            DatabaseId = domain.DatabaseId,
            Domain = domain.Domain,
            Description = domain.Description
        };

    private bool HasDuplicateDomain(DatabaseDomainDefinition domain)
    {
        var candidate = domain.Domain.Trim();

        return domains.Any(existing =>
            existing.DatabaseDomainId != domain.DatabaseDomainId &&
            string.Equals(existing.Domain.Trim(), candidate, StringComparison.OrdinalIgnoreCase));
    }

    private void Notify(NotificationSeverity severity, string detail)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = severity == NotificationSeverity.Error ? "Save failed" : "Manage Databases",
            Detail = detail,
            Duration = 3500
        });
    }

    private static string FriendlyError(Exception ex)
    {
        if (ex is SqlException sqlException && sqlException.Number is 2601 or 2627)
        {
            return "A database domain with that name already exists for this database.";
        }

        return ex.Message;
    }
}
