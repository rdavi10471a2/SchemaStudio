@page "/base-view-creator"

@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Radzen
@using Radzen.Blazor
@using SchemaStudio.Data.Models
@using SchemaStudio.Data.Repositories
@using SchemaStudioWebViewer.Components.HelpSystem
@using SchemaStudioWebViewer.Components.Pages.BaseViewCreator
@using SchemaStudioWebViewer.Data
@using SchemaStudioWebViewer.Models
@using SchemaStudioWebViewer.Utils

@* Services are injected in the code-behind (BaseViewCreator.razor.cs) via [Inject]. *@


<PageTitle>Base View Creator</PageTitle>

<div class="bvg-page">
    @if (IsBusy)
    {
        <div class="bvg-busy-overlay" role="status" aria-live="polite">
            <div class="bvg-spinner"></div>
            <div>Loading schema metadata...</div>
        </div>
    }

    <section class="bvg-header">
        <div>
            <div class="bvg-title-row">
                <h1>Base View Creator</h1>
                <RadzenIcon Icon="help_outline"
                            class="bvg-page-help-icon"
                            @onclick="@(() => OpenHelp("base-view-creator"))" />
            </div>
        </div>
        <div class="bvg-header-actions">
            <button type="button" class="bvg-button secondary" @onclick="RefreshMetadataAsync" disabled="@IsBusy">Refresh Metadata</button>
        </div>
    </section>

    <div class="@LayoutClass"
         style="@LayoutStyle"
         @onpointermove="@ResizePane"
         @onpointerup="@EndPaneResize">
        @if (!SourcePanelCollapsed)
        {
            <section class="bvg-panel bvg-source-panel">
                <header class="bvg-panel-header">Source Table</header>
            <div class="bvg-form-grid">
                <label>
                    @HelpLabel("Source Database", "Source SQL Server database used for metadata discovery and generated FROM/JOIN names.")
                    <RadzenDropDown TValue="string"
                                    Data="@Databases"
                                    TextProperty="DatabaseName"
                                    ValueProperty="DatabaseName"
                                    @bind-Value="@SelectedDatabaseName"
                                    Change="@OnDatabaseChangedAsync"
                                    Disabled="@IsBusy"
                                    Placeholder="Select database"
                                    Style="width: 100%;" />
                </label>

                <label>
                    @HelpLabel("Source Schema", "Schema that owns the source table. For most Excede source metadata this is dbo.")
                    <input value="@SelectedSchemaName" @oninput="OnSchemaNameChanged" placeholder="dbo" disabled="@IsBusy" />
                </label>

                <label>
                    @HelpLabel("Source Table", "Physical table to inspect. Loading the table discovers base columns, FK relationships, and database-specific lookup relationships.")
                    <input value="@SelectedTableName" @oninput="OnTableNameChanged" placeholder="Type table name" disabled="@IsBusy" />
                </label>

                <label>
                    @HelpLabel("Output Table Name", "Physical output table used by the Create Table and Merge tabs. *Current policy is that table names should reflect source table names by design.*")
                    <input value="@TargetTableName" @oninput="OnTargetTableNameChanged" placeholder="@(string.IsNullOrWhiteSpace(TargetViewName) ? "Output table name" : TargetViewName)" disabled />
                </label>
            </div>

            <div class="bvg-target">
                <h2>Target View</h2>
                <div class="bvg-form-grid">
                    <label>
                        @HelpLabel("Target Database", "Target integration database for the generated view name and SQL preview.")
                        <input value="@TargetDatabaseName" @oninput="OnTargetDatabaseChanged" />
                    </label>
                    <label>
                        @HelpLabel("Target Schema", "Schema for the generated CREATE OR ALTER VIEW statement.")
                        <input value="@TargetSchemaName" @oninput="OnTargetSchemaChanged" />
                    </label>
                    <label class="bvg-wide">
                        @HelpLabel("View Name", "Generated or overridden base view name. This is the object created by the copied SQL.")
                        <input value="@TargetViewName" @oninput="OnTargetViewNameChanged" />
                    </label>
                    <label>
                        @HelpLabel("Physical DB (Silver)", "Database for the Create Table and Batch Merge objects (the physical / silver layer). Used in their USE statement and as the Apply target. Defaults to VVG_Silver.")
                        <input @bind="MergeDestinationDb" placeholder="VVG_Silver" />
                    </label>
                </div>
                <div class="bvg-target-actions">
                    <button type="button"
                            class="bvg-button secondary"
                            @onclick="LoadSelectedTableAsync"
                            disabled="@(IsBusy || string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedSchemaName) || string.IsNullOrWhiteSpace(SelectedTableName))">
                        Load
                    </button>
                    <button type="button"
                            class="bvg-button secondary"
                            @onclick="ClearLoadedView"
                            disabled="@(IsBusy || (Columns.Count == 0 && string.IsNullOrWhiteSpace(SelectedTableName)))"
                            title="Clear the loaded table/view and generated SQL. Keeps the selected source database.">
                        Clear
                    </button>
                </div>
            </div>

            <div class="bvg-options">
                <label><input type="checkbox" checked="@IgnoreSelfJoins" @onchange="OnIgnoreSelfJoinsChanged" /> Ignore self joins @HelpIcon("Hides relationships where the source table references itself. The source table FK columns are still available in the Columns tab.")</label>
                <label><input type="checkbox" checked="@HideSingleMergeTab" @onchange="OnHideSingleMergeTabChanged" /> Hide Single Merge tab @HelpIcon("Hides the Single Merge tab entirely so only the Batch Merge workflow is shown. On by default.")</label>
                <label>
                    @HelpLabel("Output shape", "CTE wraps the generated table SQL in a TableName_Source unit and projects the final view from that named source. Standard emits one flat SELECT.")
                    <select value="@OutputShape" @onchange="OnOutputShapeChanged">
                        <option value="@OutputShapeCte">CTE</option>
                        <option value="@OutputShapeStandard">Standard</option>
                    </select>
                </label>
            </div>

            </section>
            <button type="button"
                    class="bvg-resize-handle"
                    title="Resize source pane"
                    aria-label="Resize source pane"
                    @onpointerdown="BeginSourcePaneResize"></button>
        }

        <section class="bvg-panel bvg-workspace-panel">
            <header class="bvg-tabs" role="tablist" aria-label="Base view generator workspace">
                <button type="button" class="@TabClass("tree")" @onclick='() => SetWorkspaceTab("tree")'>Select Projection</button>
                <button type="button" class="@TabClass("sql")" @onclick='() => SetWorkspaceTab("sql")'>Generated SQL</button>
                <button type="button" class="@TabClass("table")" @onclick='() => SetWorkspaceTab("table")'>Create Table</button>
                <button type="button" class="@TabClass("batch")" @onclick='() => SetWorkspaceTab("batch")'>Batch Merge</button>
                @if (!HideSingleMergeTab)
                {
                    <button type="button" class="@TabClass("merge")" @onclick='() => SetWorkspaceTab("merge")'>Single Merge</button>
                }
                <button type="button" class="bvg-tab bvg-source-toggle-tab" @onclick="ToggleSourcePanel">@(SourcePanelCollapsed ? "Show Source View" : "Hide Source View")</button>
            </header>

            <div class="bvg-tab-body">
                @if (ActiveWorkspaceTab == "sql")
                {
                    <div class="bvg-create-table-controls">
                        <button type="button" class="bvg-button secondary" @onclick="CopySqlAsync" disabled="@(!CanCopySql)">Copy</button>
                        <button type="button" class="bvg-button secondary" @onclick="ApplyViewSqlAsync" disabled="@(!CanApplyViewSql)" title="Execute this view against the target database on the shared connection.">Apply</button>
                    </div>
                    <div @key='$"sql-{SqlRenderVersion}"' class="sql-code-container bvg-sql-output">
                        <pre class="language-sql"><code class="language-sql">@GeneratedSqlDisplay</code></pre>
                    </div>
                }
                else if (ActiveWorkspaceTab == "table")
                {
                    <div class="bvg-create-table-controls">
                        <button type="button" class="bvg-button secondary" @onclick="CopyCreateTableSqlAsync" disabled="@string.IsNullOrWhiteSpace(GeneratedCreateTableSql)">Copy</button>
                        <button type="button" class="bvg-button secondary" @onclick="ApplyCreateTableSqlAsync" disabled="@(!CanApplyCreateTableSql)" title="Execute this CREATE TABLE against the physical database on the shared connection.">Apply</button>
                    </div>
                    <div @key='$"table-{SqlRenderVersion}"' class="sql-code-container bvg-sql-output">
                        <pre class="language-sql"><code class="language-sql">@GeneratedCreateTableSqlDisplay</code></pre>
                    </div>
                }
                else if (ActiveWorkspaceTab == "merge")
                {
                    @if (!string.IsNullOrWhiteSpace(ReplicatedSourcesError))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@ReplicatedSourcesError</RadzenAlert>
                    }
                    <section class="bvg-merge-config">
                        <header class="bvg-merge-config-header">
                            <button type="button" class="bvg-group-toggle" @onclick="ToggleMergeControls">@(MergeControlsExpanded ? "-" : "+")</button>
                            <span class="bvg-group-label">Merge Settings</span>
                        </header>
                        @if (MergeControlsExpanded)
                        {
                            <div class="bvg-create-table-controls bvg-merge-controls">
                                <div class="bvg-form-grid bvg-merge-grid">
                                    <label>
                                        @HelpLabel("Country DB", "Country code written to the CountryDB column and matched in the merge join. Linked to Source DB: choosing a country auto-selects its source database.")
                                        <select @bind="MergeCountryDb" @bind:after="OnMergeCountryDbChanged">
                                            <option value="">(select country)</option>
                                            @foreach (var countryCode in CountryCodeOptions)
                                            {
                                                <option value="@countryCode">@countryCode</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        @HelpLabel("Source DB", "Database the inlined source select reads from. Linked to Country DB: choosing one selects the other from the hardcoded map.")
                                        <select @bind="MergeSourceDb" @bind:after="OnMergeSourceDbChanged">
                                            <option value="">(select source database)</option>
                                            @foreach (var db in SourceDatabaseOptions)
                                            {
                                                <option value="@db">@db</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        @HelpLabel("Source Schema", "Schema of the source table in the inlined select.")
                                        <input @bind="MergeSourceSchema" placeholder="Source schema" />
                                    </label>
                                    <label class="bvg-merge-row-start">
                                        @HelpLabel("Destination DB", "Database that hosts the output table.")
                                        <input @bind="MergeDestinationDb" placeholder="Destination database" />
                                    </label>
                                    <label>
                                        @HelpLabel("Destination Schema", "Schema of the output table.")
                                        <input @bind="MergeDestinationSchema" placeholder="Destination schema" />
                                    </label>
                                    <label>
                                        @HelpLabel("Destination Table", "Output table the merge writes into.")
                                        <input @bind="MergeDestinationTable" placeholder="Destination table" />
                                    </label>
                                </div>
                                <div class="bvg-merge-source-actions">
                                    <button type="button" class="bvg-button primary" @onclick="RegenerateMerge" disabled="@(!CanRegenerateMerge)" title="@(CanRegenerateMerge ? null : "Fill every merge field (including Date Filter) before generating.")">Regenerate Merge</button>
                                    <button type="button" class="bvg-button secondary" @onclick="CopyMergeSqlAsync" disabled="@(!string.IsNullOrWhiteSpace(MergeUnavailableReason) || string.IsNullOrWhiteSpace(GeneratedMergeSql))">Copy</button>
                                </div>
                            </div>
                        }
                    </section>
                    @if (!string.IsNullOrWhiteSpace(MergeUnavailableReason))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@MergeUnavailableReason</RadzenAlert>
                    }
                    else
                    {
                        <div @key='$"merge-{SqlRenderVersion}"' class="sql-code-container bvg-sql-output">
                            <pre class="language-sql"><code class="language-sql">@GeneratedMergeSql</code></pre>
                        </div>
                    }
                }
                else if (ActiveWorkspaceTab == "batch")
                {
                    <section class="bvg-merge-config">
                        <header class="bvg-merge-config-header">
                            <span class="bvg-group-label">Batch Merge — loops every replicated source</span>
                        </header>
                        @if (!string.IsNullOrWhiteSpace(ReplicatedSourcesError))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@ReplicatedSourcesError</RadzenAlert>
                        }
                        <div class="bvg-create-table-controls bvg-merge-controls">
                            <p>
                                Generates a <code>CREATE OR ALTER PROCEDURE</code> named <code>MergeExcede&lt;OutputTableName&gt;</code>
                                that loops <code>VVG_Silver.dbo.ReplicatedExcedeSources</code> and runs a dynamic MERGE for each
                                <code>ReplicatedDBName</code>. It reuses the destination and source schema from the <strong>Merge</strong>
                                tab and applies the Date Filter and Date Range set below; the source database is supplied by the loop and
                                written to the <code>SourceDB</code> column.
                            </p>
                            <div class="bvg-form-grid bvg-merge-grid">
                                <label>
                                    @HelpLabel("Date Filter", "Required. Source date column that limits each MERGE to a recent window (WHERE [source].[column] >= threshold). Defaults to DateUpdate when present; if it is missing the field shows red until you pick a date column.")
                                    <select @bind="MergeDateFilterColumn" @bind:after="RegenerateMergeAfterOptionChange" class="@(string.IsNullOrWhiteSpace(MergeDateFilterColumn) ? "bvg-field-attention" : null)">
                                        <option value="">(choose a date column)</option>
                                        @foreach (var dateColumn in MergeDateFilterColumnOptions)
                                        {
                                            <option value="@dateColumn">@dateColumn</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    @HelpLabel("Date Range", "How far back the date filter reaches, relative to today. Only applied when a Date Filter column is selected.")
                                    <select @bind="MergeDateFilterRange" @bind:after="RegenerateMergeAfterOptionChange" disabled="@string.IsNullOrWhiteSpace(MergeDateFilterColumn)">
                                        <option value="@DateRange7">Last 7 days</option>
                                        <option value="@DateRange30">Last 30 days</option>
                                        <option value="@DateRange60">Last 60 days</option>
                                        <option value="@DateRangePriorMonth">First day of prior month</option>
                                        <option value="@DateRangeCurrentMonth">First day of current month</option>
                                    </select>
                                </label>
                                <label class="bvg-merge-ts-inline"><input type="checkbox" checked="@UseRowVersionColumn" @onchange="OnUseRowVersionColumnChanged" /> Use TS column @HelpIcon("On by default. Requires the base table's TS rowversion column and only updates rows whose source TS is newer than the target (WHEN MATCHED AND src.TS > tgt.TS). Turn off to drop that requirement and update every matched row.")</label>
                            </div>
                            <div class="bvg-merge-source-actions">
                                <button type="button" class="bvg-button secondary" @onclick="CopyBatchMergeSqlAsync" disabled="@(!string.IsNullOrWhiteSpace(BatchMergeUnavailableReason) || string.IsNullOrWhiteSpace(GeneratedBatchMergeSql))">Copy</button>
                                <button type="button" class="bvg-button primary" @onclick="ApplyBatchMergeSqlAsync" disabled="@(!CanApplyBatchMergeSql)" title="Create/alter this batch-merge procedure in the physical database on the shared connection.">Apply</button>
                            </div>
                        </div>
                    </section>
                    @if (!string.IsNullOrWhiteSpace(BatchMergeUnavailableReason))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@BatchMergeUnavailableReason</RadzenAlert>
                    }
                    else
                    {
                        <div @key='$"batch-{SqlRenderVersion}"' class="sql-code-container bvg-sql-output">
                            <pre class="language-sql"><code class="language-sql">@GeneratedBatchMergeSqlDisplay</code></pre>
                        </div>
                    }
                }
                else
                {
                    <div class="bvg-column-filter">
                        <input placeholder="Filter columns or relationships" value="@ColumnFilter" @oninput="OnColumnFilterChanged" />
                    </div>
                    <div class="bvg-tree-view">
                        <section class="bvg-tree-section bvg-source-tree-section">
                            <div class="bvg-tree-section-header">
                                <button type="button" class="bvg-group-toggle" @onclick="ToggleSourceGroup">@(SourceGroupExpanded ? "-" : "+")</button>
                                <span class="bvg-group-label">Source With Lookups Expanded</span>
                                <code>FROM @QualifiedName(SelectedDatabaseName, SelectedSchemaName, SelectedTableName) AS @QuoteIdentifier(BaseAlias)</code>
                                <span class="bvg-count-chip">@FilteredSelectProjectionRowCount projection row(s)</span>
                            </div>
                            @if (SourceGroupExpanded)
                            {
                                <div class="bvg-tree-children">
                                    <div class="bvg-tree-column-header">
                                        <span></span>
                                        <span></span>
                                        <span>Column Name</span>
                                        <span>Business Name</span>
                                        <span>Business Description</span>
                                        <span>Edit</span>
                                        <span>Disable Inheritance</span>
                                    </div>
                                    @foreach (var column in FilteredStandaloneColumns)
                                    {
                                        <div class="@TreeColumnRowClass(column)">
                                            <div class="bvg-tree-indent"></div>
                                            <input type="checkbox" checked="@column.Include" @onchange="args => OnColumnIncludeChanged(column, args)" />
                                            <div class="bvg-tree-main">
                                                <span class="bvg-output-expression">@BuildBaseProjectionText(column)</span>
                                                @if (!string.IsNullOrWhiteSpace(ColumnKeyRoleLabel(column)))
                                                {
                                                    <span class="bvg-role-glyph">@ColumnKeyRoleLabel(column)</span>
                                                }
                                                @if (IsSuppressedRelationshipColumn(column))
                                                {
                                                    <span class="bvg-role-glyph">No Display Selected</span>
                                                }
                                            </div>
                                            <span class="bvg-business-name">@EffectiveBaseColumnBusinessName(column)</span>
                                            <span class="bvg-business-description">@EffectiveBaseColumnBusinessDescription(column)</span>
                                            <button type="button" class="bvg-link-button" @onclick="() => OpenColumnMetadataDialog(column)">Edit</button>
                                               <span class="bvg-system-note">@YesNo(ColumnHasLookupDisplayProjection(column.ColumnName))</span>
                                        </div>
                                    }
                                    @foreach (var relationship in FilteredRelationships)
                                    {
                                        @if (RelationshipOwnsEditorProjectionColumns(relationship))
                                        {
                                            @foreach (var column in GetRelationshipColumns(relationship))
                                            {
                                                <div class="@TreeColumnRowClass(column)">
                                                    <div class="bvg-tree-indent"></div>
                                                    <input type="checkbox" checked="@column.Include" @onchange="args => OnColumnIncludeChanged(column, args)" />
                                                    <div class="bvg-tree-main">
                                                        <span class="bvg-output-expression">@BuildBaseProjectionText(column)</span>
                                                        <span class="bvg-role-glyph">FK Ref</span>
                                                        @if (!relationship.Include)
                                                        {
                                                            <span class="bvg-role-glyph bvg-role-glyph-muted">Enable Join To Project</span>
                                                        }
                                                        @if (IsJoinSuppressed(relationship))
                                                        {
                                                            <span class="bvg-role-glyph">No Display Selected</span>
                                                        }
                                                    </div>
                                                    <span class="bvg-business-name">@EffectiveRelationshipColumnBusinessName(column, relationship)</span>
                                                    <span class="bvg-business-description">@EffectiveRelationshipColumnBusinessDescription(column, relationship)</span>
                                                    <button type="button" class="bvg-link-button" @onclick="() => OpenColumnMetadataDialog(column)">Edit</button>
                                                    <span class="bvg-system-note">@YesNo(RelationshipHasLookupMetadataContext(relationship))</span>
                                                </div>
                                            }
                                        }

                                        @* Show the lookup display row for every relationship. When no display column
                                           is chosen the checkbox is disabled/unchecked, so the lookup is never projected
                                           until the user picks a display column (in the Lookups section below). *@
                                        <div class="@TreeDisplayRowClass(relationship)">
                                            <div class="bvg-tree-indent"></div>
                                            <input type="checkbox" checked="@relationship.IncludeDisplayColumn" @onchange="args => OnRelationshipDisplayIncludeChanged(relationship, args)" disabled="@string.IsNullOrWhiteSpace(relationship.DisplayColumnName)" />
                                            <div class="bvg-tree-main">
                                                <span class="bvg-output-expression">@BuildDisplayProjectionText(relationship)</span>
                                                <span class="bvg-role-glyph">Lookup</span>
                                                @if (!HasDisplayColumn(relationship))
                                                {
                                                    <span class="bvg-role-glyph bvg-role-glyph-muted">Choose display column below to project</span>
                                                }
                                                else if (!relationship.Include)
                                                {
                                                    <span class="bvg-role-glyph bvg-role-glyph-muted">Enable Join To Project</span>
                                                }
                                            </div>
                                            <span class="bvg-business-name">@EffectiveRelationshipDisplayBusinessName(relationship)</span>
                                            <span class="bvg-business-description">@EffectiveRelationshipDisplayBusinessDescription(relationship)</span>
                                            <button type="button" class="bvg-link-button" @onclick="() => OpenRelationshipDisplayMetadataDialog(relationship)">Edit</button>
                                            <span class="bvg-system-note">@YesNo(RelationshipHasLookupMetadataContext(relationship))</span>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <button type="button"
                                class="bvg-height-resize-handle"
                                title="Resize Select and From panes"
                                aria-label="Resize Select and From panes"
                                @onpointerdown="BeginProjectionPaneResize"></button>

                        <section class="bvg-tree-section bvg-lookup-tree-section">
                            <div class="bvg-tree-section-header">
                                <span class="bvg-group-label">Lookups</span>
                                <span class="bvg-count-chip">@FilteredRelationships.Count() M-to-1 relationship(s)</span>
                                <span></span>
                                <div class="bvg-tree-section-actions">
                                    <button type="button" class="bvg-button secondary" @onclick="OpenSurrogateKeyDialog">Surrogate Keys (@IncludedSurrogateKeyCount)</button>
                                    <button type="button" class="bvg-button secondary" @onclick="ExpandJoinGroups">Expand Joins</button>
                                    <button type="button" class="bvg-button secondary" @onclick="CollapseJoinGroups">Collapse Joins</button>
                                </div>
                            </div>
                            <div class="bvg-tree-children">
                                @foreach (var relationship in FilteredRelationships)
                                {
                                    <div class="@TreeRelationshipNodeClass(relationship)">
                                        <div class="bvg-tree-relationship-header">
                                            <button type="button" class="bvg-group-toggle" @onclick="() => ToggleRelationshipGroup(relationship)">@(IsRelationshipGroupExpanded(relationship) ? "-" : "+")</button>
                                            <input type="checkbox" checked="@relationship.Include" @onchange="args => OnRelationshipIncludeChanged(relationship, args)" disabled="@(!CanUseRelationship(relationship))" />
                                            <code>@BuildJoinText(relationship)</code>
                                            <span class="@RelationshipStatusClass(relationship)">@RelationshipStatusText(relationship)</span>
                                            <span class="bvg-relationship-summary">@BuildRelationshipSummaryText(relationship)</span>
                                        </div>
                                        @if (IsRelationshipGroupExpanded(relationship))
                                        {
                                            <div class="bvg-lookup-control-row">
                                                <span class="bvg-lookup-control-label">Display field</span>
                                                <RadzenDropDown TValue="string"
                                                                Data="@GetLookupDisplayColumnOptions(relationship)"
                                                                Value="@(relationship.DisplayColumnName ?? string.Empty)"
                                                                Change="@(value => OnLookupRelationshipDisplayColumnChanged(relationship, value))"
                                                                Open="@(() => EnsureLookupDisplayColumnOptionsAsync(relationship))"
                                                                AllowClear="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                Filterable="true"
                                                                Placeholder="Select display column"
                                                                class="bvg-display-dropdown" />
                                                <code>@BuildDisplayProjectionText(relationship)</code>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    </div>
                }
            </div>
            @if (ActiveWorkspaceTab == "tree")
            {
                <footer class="bvg-workspace-actions">
                    <button type="button" class="@RegenerateButtonClass" @onclick="GenerateSqlAndShow" disabled="@IsBusy">Generate</button>
                </footer>
            }
        </section>
    </div>
</div>

@if (MetadataDialogOpen)
{
    <BaseViewCreatorMetadataDialog Title="@MetadataDialogTitle"
                                   BusinessName="@MetadataEditBusinessName"
                                   BusinessDescription="@MetadataEditBusinessDescription"
                                   BusinessNameMaxLength="@MetadataBusinessNameMaxLength"
                                   BusinessDescriptionMaxLength="@MetadataBusinessDescriptionMaxLength"
                                   BusinessNameLabel="@MetadataFieldLabel(nameof(SchemaObjectColumnDefinition.BusinessName))"
                                   BusinessDescriptionLabel="@MetadataFieldLabel(nameof(SchemaObjectColumnDefinition.BusinessDescription))"
                                   OnCancel="@CloseMetadataDialog"
                                   OnApply="@ApplyMetadataDialog" />
}

@if (SurrogateKeyDialogOpen)
{
    <BaseViewSurrogateKeyDialog Keys="@SurrogateKeys"
                                ColumnOptions="@SurrogateKeyColumnOptions"
                                ExpressionFactory="@BuildSurrogateKeyExpressionForColumns"
                                LengthFactory="@BuildSurrogateKeyLengthForColumns"
                                Suffix="@SurrogateKeySuffix"
                                OnClose="@CloseSurrogateKeyDialog" />
}
