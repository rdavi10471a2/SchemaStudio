@namespace SchemaStudioWebViewer.Components.Pages
@using Microsoft.Data.SqlClient
@using SchemaStudio.Data.Models
@using SchemaStudio.Data.Repositories
@using SchemaStudioWebViewer.Data
@inject DatabaseRelationshipRepository RelationshipRepository
@inject TableSchemaSmoRepository TableSchemaRepository
@inject NotificationService NotificationService
@inject TooltipService TooltipService


<RadzenStack Gap="0.75rem"
             class="@RelationshipsPanelClass"
             style="@RelationshipsPanelStyle"
             @onpointermove="@ResizePane"
             @onpointerup="@EndPaneResize">
    @if (Database is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat">
            Select a database to maintain relationship metadata.
        </RadzenAlert>
    }
    else
    {
        <RadzenCard class="rz-p-3" Style="border:1px solid #dbe4f0;background:#f6f9fe;flex:0 0 auto;">
            <div style="display:flex;gap:0.6rem;align-items:flex-start;">
                <RadzenIcon Icon="tips_and_updates" Style="color:var(--rz-primary);font-size:1.35rem;margin-top:0.1rem;" />
                <div style="min-width:0;flex:1 1 auto;">
                    <div style="display:flex;align-items:center;gap:0.35rem;">
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">Working with the relationship registry</RadzenText>
                        @HelpIcon("Relationships stored here define the join paths the Base View tools use to assemble lookups and child collections for this database. They do not change your source database.")
                        <RadzenButton Icon="@GuideToggleIcon"
                                      Text="@GuideToggleText"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Text"
                                      Size="ButtonSize.Small"
                                      Style="margin-left:auto;color:var(--rz-primary);"
                                      title="Show or hide the workflow guide"
                                      Click="@(() => isGuideExpanded = !isGuideExpanded)" />
                    </div>
                    @if (isGuideExpanded)
                    {
                        <div style="display:flex;gap:1.25rem;align-items:flex-start;margin-top:0.4rem;max-height:300px;overflow:auto;">
                            <div style="flex:1 1 0;min-width:0;">
                                <RadzenText TextStyle="TextStyle.Body2" Style="color:#495057;margin:0 0 0.35rem;">
                                    Curate the join paths for a table, then persist them so Base View generation can reuse them.
                                </RadzenText>
                                <ol style="margin:0;padding-left:1.15rem;color:#495057;font-size:0.85rem;line-height:1.5;">
                                    <li>Pick a <strong>Schema</strong> and <strong>Table</strong> below.</li>
                                    <li><strong>Load Existing</strong> shows joins already stored for that table.</li>
                                    <li><strong>Load From Source</strong> previews foreign keys detected in the source database.</li>
                                    <li>Select a row to edit its join type, ON clause and lookup display defaults.</li>
                                    <li><strong>Save Relationship</strong> stores the selected row; <strong>Save All</strong> stores every ready row.</li>
                                </ol>
                            </div>
                            <div style="flex:1 1 0;min-width:0;border-left:1px solid #dbe4f0;padding-left:1.25rem;">
                                <div style="font-weight:700;color:#344054;font-size:0.8rem;margin-bottom:0.25rem;">Parents / Lookups vs Children</div>
                                <ul style="margin:0 0 0.5rem;padding-left:1.15rem;color:#495057;font-size:0.85rem;line-height:1.5;">
                                    <li><strong>Parents / Lookups</strong> (many-to-one): tables the selected table points to &mdash; the selected table holds the foreign key, so the other table is a parent/lookup.</li>
                                    <li><strong>Children</strong> (one-to-many): tables that point back to the selected table &mdash; they hold the foreign key, so they are child/detail collections.</li>
                                </ul>
                                <div style="font-weight:700;color:#344054;font-size:0.8rem;margin:0.35rem 0 0.35rem;">Status pills</div>
                                <div style="display:flex;flex-direction:column;gap:0.3rem;font-size:0.85rem;color:#495057;">
                                    <div style="display:flex;align-items:flex-start;gap:0.5rem;">
                                        <span class="relationship-chip" style="flex:0 0 auto;">Default Lookup</span>
                                        <span>Parent/lookup included by default in a generated base view (a display column was detected).</span>
                                    </div>
                                    <div style="display:flex;align-items:flex-start;gap:0.5rem;">
                                        <span class="relationship-chip relationship-chip-warning" style="flex:0 0 auto;">Join Only</span>
                                        <span>Known join not included by default &mdash; no display column, or set to not include.</span>
                                    </div>
                                    <div style="display:flex;align-items:flex-start;gap:0.5rem;">
                                        <span class="relationship-chip relationship-chip-warning" style="flex:0 0 auto;">Child</span>
                                        <span>A one-to-many child relationship: another table references the selected table.</span>
                                    </div>
                                    <div style="display:flex;align-items:flex-start;gap:0.5rem;">
                                        <span class="relationship-chip relationship-chip-unsaved" style="flex:0 0 auto;">Unsaved</span>
                                        <span>Staged row not yet persisted &mdash; use Save Relationship or Save All.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(statusText))
            {
                <div role="status" aria-live="polite" style="@RelationshipStatusStyle">
                    <RadzenIcon Icon="@RelationshipStatusIcon" Style="font-size:1.05rem;" />
                    <span>@statusText</span>
                </div>
            }
        </RadzenCard>

        <RadzenCard class="relationships-picker rz-p-3">
            <RadzenRow Gap="0.75rem" AlignItems="AlignItems.End">
                <RadzenColumn Size="12" SizeMD="2">
                    @FieldLabelWithHelp("Schema", "Database schema that owns the source table. Defaults to the database's default schema.")
                    <RadzenTextBox @bind-Value="@schemaName"
                                   Style="width:100%;"
                                   MaxLength="128"
                                   Change="@(async _ => await LoadTablesAsync())" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4">
                    @FieldLabelWithHelp("Table", "Source table whose parent/lookup and child relationships you are curating.")
                    <RadzenDropDown TValue="string"
                                    Data="@tables"
                                    TextProperty="TableName"
                                    ValueProperty="TableName"
                                    @bind-Value="@selectedTableName"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Style="width:100%;"
                                    Change="@(async _ => await LoadRelationshipsAsync())" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="relationship-action-bar">
                        <RadzenButton Icon="sync"
                                      Text="@LoadRelationshipsButtonText"
                                      ButtonStyle="ButtonStyle.Light"
                                      title="@LoadRelationshipsButtonTitle"
                                      Click="@LoadRelationshipsAsync"
                                      Disabled="@(!CanLoadRelationships)" />
                        <RadzenButton Icon="account_tree"
                                      Text="Load From Source"
                                      ButtonStyle="ButtonStyle.Primary"
                                      title="Load relationships detected from the source system for review before saving."
                                      Click="@ImportForeignKeysAsync"
                                      Disabled="@(!CanImport)" />
                        <RadzenButton Icon="visibility"
                                      Text="Preview Lookups"
                                      ButtonStyle="ButtonStyle.Light"
                                      title="Preview the COLOOKUP lookups this database's query would create for the selected table, before staging them."
                                      Click="@PreviewLookupCandidatesAsync"
                                      Disabled="@(!CanImport)" />
                        <RadzenButton Icon="search"
                                      Text="Load Lookups"
                                      ButtonStyle="ButtonStyle.Primary"
                                      title="Run this database's lookup query for the selected table and stage the discovered COLOOKUP lookups (mapped to DES1) for review before Save All."
                                      Click="@ImportLookupCandidatesAsync"
                                      Disabled="@(!CanImport)" />
                        <RadzenButton Icon="save"
                                      Text="Save All"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      title="Save the relationship rows currently shown."
                                      Click="@SaveAllRelationshipsAsync"
                                      Disabled="@(!CanSaveAllRelationships)" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        @if (isLoading)
        {
            <div class="relationship-busy" role="status" aria-live="polite">
                <div class="relationship-spinner"></div>
                <span>Loading relationships...</span>
            </div>
        }

        <div class="relationships-workspace" style="display:grid;grid-template-columns:var(--relationship-list-width,340px) 10px minmax(0,1fr);grid-template-rows:minmax(0,1fr);flex:1 1 auto;min-height:0;overflow:hidden;">
            <section class="relationship-list-pane">
                <div class="relationship-pane-header">
                    <div>
                        <div style="display:flex;align-items:center;gap:0.35rem;">
                            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">Relationships</RadzenText>
                            @HelpIcon("Rows touching the selected table. Parents / Lookups are joins this table points to; Children are tables that point back to it.")
                        </div>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:#667085;">@RelationshipCountLabel</RadzenText>
                    </div>
                    <RadzenButton Icon="add"
                                  Text="New"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@NewRelationship"
                                  Disabled="@(Database is null || string.IsNullOrWhiteSpace(selectedTableName))" />
                </div>
                <div class="relationship-list-tabs">
                    <button type="button"
                            class="@RelationshipListTabClass(SourceListMode)"
                            @onclick="@(() => SetRelationshipListMode(SourceListMode))">
                        Parents / Lookups <span>@relationships.Count</span>
                    </button>
                    <button type="button"
                            class="@RelationshipListTabClass(ChildrenListMode)"
                            @onclick="@(() => SetRelationshipListMode(ChildrenListMode))">
                        Children <span>@childRelationships.Count</span>
                    </button>
                </div>

                <div class="relationship-list">
                    @if (VisibleRelationships.Count == 0)
                    {
                        <div class="relationship-empty">@EmptyRelationshipListText</div>
                    }
                    else
                    {
                        @foreach (var relationship in VisibleRelationships)
                        {
                            <button type="button"
                                    class="@RelationshipRowClass(relationship)"
                                    @onclick="@(() => SelectRelationship(relationship))">
                                <span class="relationship-row-meta">
                                    <span class="@RelationshipStatusChipClass(relationship)">@RelationshipStatusText(relationship)</span>
                                    @if (IsImportedRelationship(relationship))
                                    {
                                        <RadzenIcon Icon="download_done"
                                                    class="relationship-imported-icon"
                                                    title="Imported relationship already saved" />
                                    }
                                </span>
                                <strong>@RelationshipOtherTable(relationship)</strong>
                                <code>@relationship.JoinType</code>
                                <span>@relationship.ColumnSummary</span>
                            </button>
                        }
                    }
                </div>
            </section>

            <button type="button"
                    class="relationship-resize-handle"
                    title="Resize relationship browser"
                    aria-label="Resize relationship browser"
                    @onpointerdown="@BeginPaneResize"></button>

            <section class="relationship-edit-pane" style="display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden;">
                <div class="relationship-pane-header">
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@RelationshipEditorTitle</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Style="color:#667085;">@RelationshipEditorSubtitle</RadzenText>
                    </div>
                    @if (editRelationship is not null)
                    {
                        <span class="relationship-editor-status">
                            <span class="@RelationshipStatusChipClass(editRelationship)">@RelationshipStatusText(editRelationship)</span>
                            @if (IsImportedRelationship(editRelationship))
                            {
                                <RadzenIcon Icon="download_done"
                                            class="relationship-imported-icon"
                                            title="Imported relationship already saved" />
                            }
                        </span>
                    }
                </div>

                @if (editRelationship is null)
                {
                    <div class="relationship-empty relationship-edit-empty">Select or create a relationship.</div>
                }
                else
                {
                    <RadzenTemplateForm TItem="DatabaseRelationshipDefinition"
                                        class="relationship-editor-form"
                                        style="display:flex;flex-direction:column;flex:1 1 auto;min-height:0;height:auto;overflow:auto;"
                                        Data="@editRelationship"
                                        Submit="@SaveRelationshipAsync">
                        <DataAnnotationsValidator />

                        <div class="relationship-edit-grid relationship-primary-grid">
                            <label>
                                @FieldLabelWithHelp("Join Type", "SQL join used when this relationship is emitted in a generated base view. LEFT JOIN keeps rows with no match; INNER JOIN drops them.")
                                <RadzenDropDown TValue="string"
                                                Data="@joinTypes"
                                                @bind-Value="@editRelationship.JoinType"
                                                Style="width:100%;" />
                            </label>
                            <label>
                                @FieldLabelWithHelp("Target Table", "The table this relationship joins to. For a parent/lookup row this is the referenced table.")
                                <RadzenTextBox @bind-Value="@editRelationship.TargetTableName"
                                               Style="width:100%;"
                                               MaxLength="128" />
                            </label>
                            <label class="relationship-compact-field">
                                @if (CanEditLookupDefaults(editRelationship))
                                {
                                    @FieldLabelWithHelp("Lookup Default", "Whether this lookup is included by default when a base view is generated. Auto-set to Include only when a display column was detected on the target table.")
                                    <RadzenDropDown TValue="string"
                                                    Data="@baseViewActions"
                                                    Value="@BaseViewActionFor(editRelationship)"
                                                    Change="@(value => SetBaseViewAction(value))"
                                                    Style="width:100%;" />
                                }
                            </label>
                            @if (CanEditLookupDefaults(editRelationship))
                            {
                                <label class="relationship-compact-field">
                                    @FieldLabelWithHelp("Display Column", "Column from the target table shown as the human-readable value for this lookup, e.g. Name or Des.")
                                    <RadzenDropDown TValue="string"
                                                    Data="@targetColumnOptions"
                                                    @bind-Value="@editRelationship.DisplayColumnName"
                                                    Change="@OnDisplayColumnChanged"
                                                    Open="@LoadTargetColumnOptionsAsync"
                                                    AllowClear="true"
                                                    AllowFiltering="true"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Placeholder="Load on open"
                                                    Style="width:100%;" />
                                </label>
                            }

                            <div class="relationship-wide relationship-statement">
                                <div class="relationship-statement-line">
                                    <span>FROM</span>
                                    <code>@editRelationship.SourceObject</code>
                                    <span>AS</span>
                                    <code>@QuoteIdentifier(editRelationship.SourceTableName)</code>
                                    <span>@editRelationship.JoinType</span>
                                    <code>@editRelationship.TargetObject</code>
                                    <span>AS</span>
                                    <code>@QuoteIdentifier(editRelationship.TargetTableName)</code>
                                </div>
                            </div>

                            <label class="relationship-wide relationship-join-editor">
                                @FieldLabelWithHelp("ON Clause", "The join predicate, written as SQL. Column pairs are parsed from this expression when the relationship is saved.")
                                <RadzenTextArea @bind-Value="@editRelationship.JoinExpression"
                                                Style="width:100%;"
                                                Rows="5"
                                                MaxLength="2000" />
                            </label>

                            @if (CanEditLookupDefaults(editRelationship) && IsConstrainedLookupTarget(editRelationship))
                            {
                                <label class="relationship-compact-field">
                                    @FieldLabelWithHelp("Filter Column", "Optional target column used to constrain a COLOOKUP-style lookup to a fixed value.")
                                    <RadzenDropDown TValue="string"
                                                    Data="@targetColumnOptions"
                                                    @bind-Value="@editRelationship.FilterColumnName"
                                                    Open="@LoadTargetColumnOptionsAsync"
                                                    AllowClear="true"
                                                    AllowFiltering="true"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Placeholder="Load on open"
                                                    Style="width:100%;" />
                                </label>
                                <label class="relationship-compact-field">
                                    @FieldLabelWithHelp("Filter Value", "Fixed value paired with the filter column to constrain the lookup.")
                                    <RadzenTextBox @bind-Value="@editRelationship.FilterValue"
                                                   Style="width:100%;"
                                                   MaxLength="128" />
                                </label>
                            }
                        </div>

                        <details class="relationship-advanced">
                            <summary>Record details</summary>
                            <div class="relationship-edit-grid">
                                <label>
                                    <span class="relationship-field-label">Source Schema</span>
                                    <RadzenTextBox @bind-Value="@editRelationship.SourceSchemaName"
                                                   Style="width:100%;"
                                                   MaxLength="128" />
                                </label>
                                <label>
                                    <span class="relationship-field-label">Source Table</span>
                                    <RadzenTextBox @bind-Value="@editRelationship.SourceTableName"
                                                   Style="width:100%;"
                                                   MaxLength="128" />
                                </label>
                                <label>
                                    <span class="relationship-field-label">Target Schema</span>
                                    <RadzenTextBox @bind-Value="@editRelationship.TargetSchemaName"
                                                   Style="width:100%;"
                                                   MaxLength="128" />
                                </label>
                                <label>
                                    <span class="relationship-field-label">Target Table</span>
                                    <RadzenTextBox @bind-Value="@editRelationship.TargetTableName"
                                                   Style="width:100%;"
                                                   MaxLength="128" />
                                </label>
                                <label class="relationship-wide">
                                    <span class="relationship-field-label">Developer Notes</span>
                                    <RadzenTextArea @bind-Value="@editRelationship.DeveloperNotes"
                                                    Style="width:100%;"
                                                    Rows="3"
                                                    MaxLength="1000" />
                                </label>
                            </div>
                        </details>

                        <div class="relationship-actions">
                            <RadzenButton Icon="refresh"
                                          Text="Reset"
                                          ButtonStyle="ButtonStyle.Light"
                                          Click="@ResetRelationshipEdit"
                                          Disabled="@(selectedRelationship is null)" />
                            <RadzenButton Icon="delete"
                                          Text="Delete"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@DeleteRelationshipAsync"
                                          Disabled="@(selectedRelationship is null || selectedRelationship.DatabaseRelationshipId == 0)" />
                            <RadzenButton Icon="save"
                                          Text="Save Relationship"
                                          ButtonType="ButtonType.Submit"
                                          ButtonStyle="ButtonStyle.Primary" />
                        </div>
                    </RadzenTemplateForm>
                }
            </section>
        </div>
    }
</RadzenStack>

@if (showLookupPreview)
{
    <div class="lookup-preview-backdrop" @onclick="CloseLookupPreview">
        <div class="lookup-preview-dialog" @onclick:stopPropagation="true">
            <div class="lookup-preview-header">
                <span>Lookup preview@(string.IsNullOrWhiteSpace(selectedTableName) ? "" : $" for {selectedTableName.Trim()}") — @lookupPreview.Count candidate(s)</span>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@CloseLookupPreview" title="Close" />
            </div>
            <div class="lookup-preview-body">
                @if (lookupPreview.Count == 0)
                {
                    <p class="lookup-preview-empty">No COLOOKUP lookup candidates were returned for this table.</p>
                }
                else
                {
                    <table class="lookup-preview-table">
                        <thead>
                            <tr>
                                <th>Source Column</th>
                                <th>Lookup Target</th>
                                <th>Display</th>
                                <th>Filter</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var preview in lookupPreview)
                            {
                                <tr>
                                    <td>@(preview.Columns.FirstOrDefault()?.SourceColumnName)</td>
                                    <td>@($"{preview.TargetSchemaName}.{preview.TargetTableName}")</td>
                                    <td>@preview.DisplayColumnName</td>
                                    <td>@($"{preview.FilterColumnName} = '{preview.FilterValue}'")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="lookup-preview-footer">
                <RadzenButton Icon="playlist_add"
                              Text="Load These"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@StageLookupPreviewFromPopup"
                              Disabled="@(lookupPreview.Count == 0)"
                              title="Stage these lookups into the list, then use Save All to write them back." />
                <RadzenButton Icon="close" Text="Close" ButtonStyle="ButtonStyle.Light" Click="@CloseLookupPreview" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public DatabaseDefinition? Database { get; set; }

    private int? loadedDatabaseId;
    private string schemaName = "dbo";
    private string selectedTableName = "";
    private List<TableSchemaTableInfo> tables = new();
    private List<DatabaseRelationshipDefinition> relationships = new();
    private List<DatabaseRelationshipDefinition> childRelationships = new();
    private IList<DatabaseRelationshipDefinition> selectedRelationships = new List<DatabaseRelationshipDefinition>();
    private DatabaseRelationshipDefinition? selectedRelationship;
    private DatabaseRelationshipDefinition? editRelationship;
    private List<string> targetColumnOptions = new();
    private string targetColumnOptionsKey = "";
    private bool isLoading;
    private bool isGuideExpanded = true;
    private string statusText = "";
    private AlertStyle statusStyle = AlertStyle.Info;
    private bool isResizingRelationshipList;
    private double resizeStartX;
    private int resizeStartWidth;
    private int relationshipListWidth = RelationshipListDefaultWidth;
    private string relationshipListMode = SourceListMode;
    private bool showLookupPreview;
    private List<DatabaseRelationshipDefinition> lookupPreview = new();

    private const int RelationshipListDefaultWidth = 340;
    private const int RelationshipListMinWidth = 260;
    private const int RelationshipListMaxWidth = 560;
    private const string SourceListMode = "source";
    private const string ChildrenListMode = "children";
    private const string BaseViewActionUseLookup = "Include lookup by default";
    private const string BaseViewActionIgnore = "Do not include by default";
    private const string DiscoveryManual = "Manual";
    private const string DiscoveryManualChild = "ManualChild";
    private const string DiscoverySchemaLookup = "SchemaLookup";
    private const string DiscoverySchemaChild = "SchemaChild";
    // COLOOKUP is the shared code/lookup table; its lookups always project the DES1 description column.
    private const string ColookupTargetSchema = "dbo";
    private const string ColookupTargetTable = "COLOOKUP";
    private const string ColookupKeyColumn = "Id";
    private const string ColookupFilterColumn = "Name";
    private const string ColookupDisplayColumn = "DES1";
    private static readonly string[] joinTypes = ["LEFT JOIN", "INNER JOIN", "LEFT OUTER JOIN", "JOIN"];
    private static readonly string[] baseViewActions = [BaseViewActionUseLookup, BaseViewActionIgnore];
    private static readonly Dictionary<int, RelationshipPanelState> stateByDatabaseId = new();

    private string RelationshipsPanelClass =>
        isResizingRelationshipList ? "relationships-panel relationship-resizing" : "relationships-panel";

    private string RelationshipsPanelStyle =>
        $"--relationship-list-width: {relationshipListWidth}px;display:flex;flex-direction:column;height:100%;max-height:calc(95vh - 4rem);min-height:0;overflow:hidden;padding:1rem;box-sizing:border-box;";

    private List<DatabaseRelationshipDefinition> VisibleRelationships =>
        relationshipListMode.Equals(ChildrenListMode, StringComparison.OrdinalIgnoreCase)
            ? childRelationships
            : relationships;

    private string RelationshipCountLabel =>
        relationshipListMode.Equals(ChildrenListMode, StringComparison.OrdinalIgnoreCase)
            ? $"{childRelationships.Count} existing children referencing {selectedTableName}"
            : $"{relationships.Count} existing parent/lookup target(s) for {selectedTableName}";

    private string EmptyRelationshipListText =>
        relationshipListMode.Equals(ChildrenListMode, StringComparison.OrdinalIgnoreCase)
            ? "No existing child relationships are stored for this table."
            : "No existing parent or lookup relationships are stored for this table.";

    private bool CanImport =>
        Database is not null &&
        !isLoading &&
        !string.IsNullOrWhiteSpace(selectedTableName);

    private bool CanLoadRelationships =>
        CanImport &&
        !string.IsNullOrWhiteSpace(schemaName);

    private bool CanSaveAllRelationships =>
        Database is not null &&
        !isLoading &&
        relationships.Concat(childRelationships).Any(IsPersistableRelationship);

    private bool HasStoredRelationships =>
        relationships.Concat(childRelationships).Any(relationship => relationship.DatabaseRelationshipId != 0);

    private string LoadRelationshipsButtonText =>
        HasStoredRelationships ? "Refresh Existing" : "Load Existing";

    private string LoadRelationshipsButtonTitle =>
        HasStoredRelationships
            ? "Reload the stored relationships for the selected table, discarding any unsaved preview rows."
            : "Load the stored relationships for the selected table.";

    private string RelationshipStatusIcon => statusStyle switch
    {
        AlertStyle.Success => "check_circle",
        AlertStyle.Warning => "warning",
        AlertStyle.Danger => "error",
        _ => "info"
    };

    private string GuideToggleIcon => isGuideExpanded ? "expand_less" : "expand_more";

    private string GuideToggleText => isGuideExpanded ? "Hide" : "Show";

    private string RelationshipStatusStyle
    {
        get
        {
            var (background, border, color) = statusStyle switch
            {
                AlertStyle.Success => ("#e7f6ec", "#b7e0c4", "#1e7d43"),
                AlertStyle.Warning => ("#fdf4e3", "#f3ddab", "#8a6100"),
                AlertStyle.Danger => ("#fdecec", "#f3bcbc", "#b42318"),
                _ => ("#eef4fd", "#c9dcf7", "#1c4f9c")
            };

            return $"display:flex;align-items:center;gap:0.5rem;margin-top:0.6rem;padding:0.5rem 0.7rem;border-radius:6px;font-size:0.85rem;background:{background};border:1px solid {border};color:{color};";
        }
    }

    private RenderFragment HelpIcon(string help) =>@<RadzenIcon Icon="help_outline"
                                                              Style="cursor:help;color:var(--rz-primary);font-size:0.95rem;opacity:0.8;"
                                                              MouseEnter="@(args => TooltipService.Open(args, help))" />;

    private RenderFragment FieldLabelWithHelp(string text, string help) =>@<span class="relationship-field-label" style="display:flex;align-items:center;gap:0.3rem;">
        @text
        @HelpIcon(help)
    </span>;

    protected override async Task OnParametersSetAsync()
    {
        if (Database is null)
        {
            loadedDatabaseId = null;
            tables.Clear();
            relationships.Clear();
            childRelationships.Clear();
            selectedTableName = "";
            selectedRelationship = null;
            selectedRelationships.Clear();
            editRelationship = null;
            return;
        }

        if (loadedDatabaseId == Database.DatabaseId)
        {
            return;
        }

        loadedDatabaseId = Database.DatabaseId;
        schemaName = string.IsNullOrWhiteSpace(Database.DefaultSchema) ? "dbo" : Database.DefaultSchema;
        selectedTableName = "";
        selectedRelationship = null;
        selectedRelationships.Clear();
        editRelationship = null;
        targetColumnOptions.Clear();
        targetColumnOptionsKey = "";
        relationshipListMode = SourceListMode;

        if (stateByDatabaseId.TryGetValue(Database.DatabaseId, out var cachedState) &&
            HasUsableCachedState(cachedState))
        {
            RestoreState(cachedState);
            return;
        }

        await LoadTablesAsync();
    }

    private async Task LoadTablesAsync()
    {
        await LoadTablesAsync(keepSelectedTable: false);
    }

    private async Task LoadTablesAsync(bool keepSelectedTable)
    {
        if (Database is null || string.IsNullOrWhiteSpace(schemaName))
        {
            return;
        }

        isLoading = true;
        SetStatus("", AlertStyle.Info);
        await InvokeAsync(StateHasChanged);

        try
        {
            tables = (await TableSchemaRepository.GetTablesAsync(Database.DatabaseName, schemaName.Trim())).ToList();

            if (keepSelectedTable && tables.Any(table => table.TableName.Equals(selectedTableName, StringComparison.OrdinalIgnoreCase)))
            {
                // Keep current selection.
            }
            else
            {
                selectedTableName = tables.FirstOrDefault()?.TableName ?? "";
            }

            await LoadRelationshipsAsync(setLoading: false);
            CacheState();
        }
        catch (Exception ex)
        {
            tables.Clear();
            relationships.Clear();
            childRelationships.Clear();
            selectedRelationship = null;
            selectedRelationships.Clear();
            editRelationship = null;
            SetStatus(FriendlyError(ex), AlertStyle.Danger);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadRelationshipsAsync()
    {
        await LoadRelationshipsAsync(setLoading: true);
    }

    private async Task LoadRelationshipsAsync(bool setLoading)
    {
        if (Database is null || string.IsNullOrWhiteSpace(schemaName) || string.IsNullOrWhiteSpace(selectedTableName))
        {
            relationships.Clear();
            childRelationships.Clear();
            selectedRelationship = null;
            selectedRelationships.Clear();
            editRelationship = null;
            CacheState();
            return;
        }

        if (setLoading)
        {
            isLoading = true;
            SetStatus("", AlertStyle.Info);
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            var selectedSchema = schemaName.Trim();
            var selectedTable = selectedTableName.Trim();
            // Anchor classification to the selected table as the relationship Source only.
            // Each table's own import stores both its parent/lookup rows (Source = this table,
            // pointing to a referenced table) and its child rows (Source = this table, pointing
            // to a table that references it), so Source == selected fully covers this table's
            // relationships with the join oriented [thisTable] = [otherTable]. Rows where the
            // selected table is only the Target belong to the other table's registration and are
            // intentionally not shown here (they would otherwise appear with an inverted pill and
            // a backwards ON clause).
            var ownedRelationships = (await RelationshipRepository.GetForDatabaseAsync(Database.DatabaseId))
                .Where(relationship => IsSelectedSource(relationship, selectedSchema, selectedTable))
                .ToList();

            relationships = ownedRelationships
                .Where(relationship => !IsChildRelationship(relationship))
                .ToList();
            childRelationships = ownedRelationships
                .Where(relationship => IsChildRelationship(relationship))
                .ToList();

            selectedRelationship = VisibleRelationships.FirstOrDefault();
            selectedRelationships = selectedRelationship is null
                ? new List<DatabaseRelationshipDefinition>()
                : new List<DatabaseRelationshipDefinition> { selectedRelationship };
            editRelationship = selectedRelationship is null ? null : CloneRelationship(selectedRelationship);
            targetColumnOptions.Clear();
            targetColumnOptionsKey = "";

            if (setLoading)
            {
                SetStatus(ExistingRelationshipStatusMessage(selectedTableName), AlertStyle.Info);
            }
            CacheState();
        }
        catch (Exception ex)
        {
            relationships.Clear();
            childRelationships.Clear();
            selectedRelationship = null;
            selectedRelationships.Clear();
            editRelationship = null;
            CacheState();
            SetStatus(FriendlyError(ex), AlertStyle.Danger);
        }
        finally
        {
            if (setLoading)
            {
                isLoading = false;
            }
        }
    }

    private async Task ImportForeignKeysAsync()
    {
        if (Database is null || string.IsNullOrWhiteSpace(selectedTableName))
        {
            return;
        }

        isLoading = true;
        SetStatus("", AlertStyle.Info);
        await InvokeAsync(StateHasChanged);

        try
        {
            var details = await TableSchemaRepository.GetTableDetailsAsync(
                Database.DatabaseName,
                schemaName.Trim(),
                selectedTableName.Trim());

            var imported = 0;
            var childImported = 0;
            var failed = 0;
            string? firstFailure = null;
            foreach (var sourceRelationship in details.Relationships)
            {
                try
                {
                    var relationship = await FromSourceLookupAsync(Database.DatabaseId, details, sourceRelationship);
                    StageRelationship(relationships, relationship);
                    imported++;
                }
                catch (Exception ex)
                {
                    failed++;
                    firstFailure ??= FriendlyError(ex);
                }
            }

            foreach (var childRelationship in details.ChildRelationships)
            {
                try
                {
                    var relationship = FromChildRelationship(Database.DatabaseId, details, childRelationship);
                    StageRelationship(childRelationships, relationship);
                    childImported++;
                }
                catch (Exception ex)
                {
                    failed++;
                    firstFailure ??= FriendlyError(ex);
                }
            }

            var message = failed == 0
                ? $"Previewed {imported} source lookup relationship(s) and {childImported} child relationship(s) for {selectedTableName}. Select a row and Save Relationship to persist it."
                : $"Previewed {imported} source lookup relationship(s) and {childImported} child relationship(s) for {selectedTableName}; {failed} relationship(s) were skipped. Select a row and Save Relationship to persist it.";
            if (!string.IsNullOrWhiteSpace(firstFailure))
            {
                message = $"{message} First failure: {firstFailure}";
            }
            SetStatus(message, failed == 0 ? AlertStyle.Success : AlertStyle.Warning);
            Notify(failed == 0 ? NotificationSeverity.Success : NotificationSeverity.Warning, message);
            relationshipListMode = SourceListMode;
            selectedRelationship = relationships.FirstOrDefault();
            selectedRelationships = selectedRelationship is null
                ? new List<DatabaseRelationshipDefinition>()
                : new List<DatabaseRelationshipDefinition> { selectedRelationship };
            editRelationship = selectedRelationship is null ? null : CloneRelationship(selectedRelationship);
            CacheState();
        }
        catch (Exception ex)
        {
            SetStatus(FriendlyError(ex), AlertStyle.Danger);
            Notify(NotificationSeverity.Error, FriendlyError(ex));
        }
        finally
        {
            isLoading = false;
        }
    }

