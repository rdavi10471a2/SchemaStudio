@page "/"

@using SchemaStudioWebViewer.Configuration
@using SchemaStudioWebViewer.Data
@using SchemaStudioWebViewer.Models
@using SchemaStudioWebViewer.Components
@using SchemaStudioWebViewer.Components.Dialogs
@using SchemaStudioWebViewer.Components.HelpSystem
@using SchemaStudioWebViewer.Utils
@using SchemaStudioWebViewer.WEBSemanticModel.Services
@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService
@inject NotificationService NotificationService
@inject TooltipService TooltipService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<style>
    .view-label-blue {
        color: var(--rz-primary) !important;
        font-weight: 400 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 8px;
        min-height: 24px;
    }

    .metadata-scroll-box {
        background-color: #f6f8f9 !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 4px;
        padding: 10px;
        height: 120px;
        overflow-y: auto;
        overflow-x: hidden;
        width: 100%;
        font-family: var(--rz-text-font-family) !important;
        font-size: 0.875rem !important;
        color: #495057;
        line-height: 1.5;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .header-text-bold {
        font-weight: 600 !important;
        color: #000 !important;
    }

    .flex-header {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .grid-wrapper {
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }

    .section-header {
        color: var(--rz-primary);
        font: 14pt;
        font-weight:bold;
        margin-bottom: 12px;
       /* border-bottom: 2px solid var(--rz-primary);*/
        padding-bottom: 4px;
    }
</style>

<PageTitle>Choose View</PageTitle>

<RadzenCard Variant="Variant.Flat" Class="rz-p-2 rz-mb-2">

    <RadzenRow Class="rz-mb-2 rz-px-1">

        <RadzenColumn Size="10">
            <RadzenText TextStyle="TextStyle.Caption"
                        Style="color:#212529;font-weight:700;font-style:normal;">
                Choose a source Database, Business Domain, and view to see its details.
            </RadzenText>
        </RadzenColumn>

        <RadzenColumn Size="2" Class="rz-text-align-right">
            <RadzenIcon Icon="help_outline"
                        Style="cursor:help;color:var(--rz-primary);font-size:1.25rem;"
                        @onclick="@(() => OpenHelp("system-overview"))"
                        @ondblclick="@EnterAdminMode" />
        </RadzenColumn>

    </RadzenRow>

    <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
@* 
        <RadzenColumn Size="12" SizeMD="2">
            <RadzenText TextStyle="TextStyle.H6" Class="rz-m-0 header-text-bold">
                CHOOSE VIEW
            </RadzenText>
        </RadzenColumn> *@

        <RadzenColumn Size="12" SizeMD="3">
            <div class="rz-display-flex rz-align-items-center">
                <RadzenIcon Icon="info"
                            Class="rz-mr-2"
                            Style="cursor:pointer;color:var(--rz-info);"
                            @onclick="@(() => OpenHelp("explore-databases"))" />

                <RadzenDropDown Data="@Databases"
                                TextProperty="DatabaseName"
                                ValueProperty="DatabaseId"
                                Placeholder="Database"
                                @bind-Value="@SelectedDatabaseId"
                                Change="@OnDatabaseChanged"
                                Style="width:100%;"
                                AllowClear="true" />
            </div>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="3">
            <RadzenDropDown Data="@Domains"
                            TextProperty="Domain"
                            ValueProperty="Domain"
                            Placeholder="Business Domain"
                            @bind-Value="@SelectedDomain"
                            Change="@OnDomainChanged"
                            Disabled="@(!SelectedDatabaseId.HasValue)"
                            Style="width:100%;"
                            AllowClear="true" />
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="4">
            <RadzenDropDown Data="@DisplayObjects"
                            TextProperty="DisplayName"
                            ValueProperty="SchemaObjectId"
                            Placeholder="View"
                            @bind-Value="@SelectedObjectId"
                            Change="@OnObjectChanged"
                            Disabled="@string.IsNullOrWhiteSpace(SelectedDomain)"
                            Style="width:100%;"
                            AllowClear="true">

                <Template Context="obj">
                    @{
                        var item = obj as DisplaySchemaObject;
                    }

                    @if (item?.IsHeader == true)
                    {
                        <div style="font-weight:700;color:#888;background:#f5f5f5;padding:.35rem .5rem;">
                            @item.DisplayName
                        </div>
                    }
                    else
                    {
                        <div class="rz-display-flex rz-align-items-center" style="gap:.5rem;">
                            @if (item?.IsBaseObject == true)
                            {
                                <RadzenIcon Icon="layers"
                                            Style="font-size:14px;color:var(--rz-primary);" />
                            }

                            <span>@item?.DisplayName</span>
                        </div>
                    }
                </Template>
            </RadzenDropDown>
        </RadzenColumn>

    </RadzenRow>
</RadzenCard>

@if (IsLoading)
{
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Class="rz-mb-2" />
}

@if (SelectedObject != null)
{
    <div class="section-header">
        VIEW DETAILS
    </div>

    <RadzenCard Variant="Variant.Filled"
                Class="rz-mb-4 rz-p-3"
                Style="background-color:#ffffff;;"
                 >

        <RadzenRow Gap="1rem">

            <RadzenColumn Size="12" SizeMD="3">
                <div class="view-label-blue">
                    @ReflectionUtils.GetDisplayName(typeof(SchemaObjectModel), "BusinessName")
                    <RadzenIcon Icon="help_outline"
                                MouseEnter="@(args => TooltipService.Open(args,ReflectionUtils.GetDescription(typeof(SchemaObjectModel), "BusinessName")))" />
            </div>

                <RadzenText Style="font-size:14pt; font-weight:bold;">
                    @SelectedObject.BusinessName
                </RadzenText>

                @* 2026-04-15 02:45 PM CDT AI parser integration marker: use raw parser SQL plus attribute-driven popup grids for parser tables and parser columns. *@
                <RadzenButton Icon="code"
                              Text="VIEW SQL"
                              Click="@ShowViewDefinition" />

                <RadzenButton Icon="integration_instructions"
                              Text="PARSER SQL"
                              Style="margin-left:0.5rem;"
                              Click="@ShowParserViewDefinition" />

                <RadzenButton Icon="table_rows"
                              Text="PARSER TABLES"
                              Style="margin-left:0.5rem;"
                              Click="@ShowParserTables" />

                <RadzenButton Icon="view_column"
                              Text="PARSER COLUMNS"
                              Style="margin-left:0.5rem;"
                              Click="@ShowParserColumns" />
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="4">
                <div class="view-label-blue">
                    @ReflectionUtils.GetDisplayName(typeof(SchemaObjectModel), "BusinessDescription")
                    <RadzenIcon Icon="help_outline"
                                MouseEnter="@(args => TooltipService.Open(args,
                                                                                            ReflectionUtils.GetDescription(typeof(SchemaObjectModel), "BusinessDescription")))" />
            </div>

            <div class="metadata-scroll-box">
                @SelectedObject.BusinessDescription
            </div>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="5">
            <div class="view-label-blue">
                @ReflectionUtils.GetDisplayName(typeof(SchemaObjectModel), "DeveloperNotes")
                <RadzenIcon Icon="help_outline"
                            MouseEnter="@(args => TooltipService.Open(args,
                                                                                            ReflectionUtils.GetDescription(typeof(SchemaObjectModel), "DeveloperNotes")))" />
            </div>

            <div class="metadata-scroll-box">
                @SelectedObject.DeveloperNotes
            </div>
        </RadzenColumn>

    </RadzenRow>

</RadzenCard>

<div class="grid-wrapper">

    <RadzenDataGrid Data="@Columns"
                    TItem="SchemaObjectColumnModel"
                    AllowPaging="false"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    Density="Density.Compact"
                    Style="height:500px;"
                    RowDoubleClick="@(args => OpenRowDetails(args.Data))">

        <HeaderTemplate>
            <div class="section-header" style="margin-bottom:0;">
                COLUMN DETAILS -- DOUBLE CLICK TO SEE MORE
            </div>
        </HeaderTemplate>

        <Columns>

            <RadzenDataGridColumn TItem="SchemaObjectColumnModel"
                                  Property="OrdinalPosition"
                                  Width="125px">
                <HeaderTemplate>
                    <div class="view-label-blue">
                        @ReflectionUtils.GetDisplayName(typeof(SchemaObjectColumnModel), "OrdinalPosition")
                        <RadzenIcon Icon="help_outline"
                                    MouseEnter="@(args => TooltipService.Open(args,
                                                                                                                    ReflectionUtils.GetDescription(typeof(SchemaObjectColumnModel), "OrdinalPosition")))" />
                    </div>
                </HeaderTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="SchemaObjectColumnModel" Property="SourceColumnName">
                <HeaderTemplate>
                    <div class="view-label-blue">
                        @ReflectionUtils.GetDisplayName(typeof(SchemaObjectColumnModel), "SourceColumnName")
                        <RadzenIcon Icon="help_outline"
                                    MouseEnter="@(args => TooltipService.Open(args,
                                                                                                                    ReflectionUtils.GetDescription(typeof(SchemaObjectColumnModel), "SourceColumnName")))" />
                    </div>
                </HeaderTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="SchemaObjectColumnModel" Property="BusinessName">
                <HeaderTemplate>
                    <div class="view-label-blue">
                        @ReflectionUtils.GetDisplayName(typeof(SchemaObjectColumnModel), "BusinessName")
                        <RadzenIcon Icon="help_outline"
                                    MouseEnter="@(args => TooltipService.Open(args,
                                                                                                                    ReflectionUtils.GetDescription(typeof(SchemaObjectColumnModel), "BusinessName")))" />
                    </div>
                </HeaderTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="SchemaObjectColumnModel" Property="BusinessDescription">
                <HeaderTemplate>
                    <div class="view-label-blue">
                        @ReflectionUtils.GetDisplayName(typeof(SchemaObjectColumnModel), "BusinessDescription")
                        <RadzenIcon Icon="help_outline"
                                    MouseEnter="@(args => TooltipService.Open(args,
                                                                                                                    ReflectionUtils.GetDescription(typeof(SchemaObjectColumnModel), "BusinessDescription")))" />
                    </div>
                </HeaderTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="SchemaObjectColumnModel" Property="DeveloperNotes">
                <HeaderTemplate>
                    <div class="view-label-blue">
                        @ReflectionUtils.GetDisplayName(typeof(SchemaObjectColumnModel), "DeveloperNotes")
                        <RadzenIcon Icon="help_outline"
                                    MouseEnter="@(args => TooltipService.Open(args,
                                                                                                                    ReflectionUtils.GetDescription(typeof(SchemaObjectColumnModel), "DeveloperNotes")))" />
                    </div>
                </HeaderTemplate>
            </RadzenDataGridColumn>

        </Columns>

    </RadzenDataGrid>

</div>
}
@code {

    private List<DatabaseModel> Databases = new();
    private List<DatabaseDomainModel> Domains = new();
    private List<DisplaySchemaObject> DisplayObjects = new();
    private List<SchemaObjectColumnModel> Columns = new();

    private int? SelectedDatabaseId;
    private string SelectedDomain = "";
    private int? SelectedObjectId;
    private int? LastValidObjectId;

    private SchemaObjectModel? SelectedObject;

    private bool IsLoading = false;

    private DatabaseRepository DbRepo =
        new(AppConfig.Current.ConnectionStrings.DefaultConnection);

    private SchemaObjectRepository SchemaRepo =
        new(AppConfig.Current.ConnectionStrings.DefaultConnection);

    private ViewDefinitionRepository ViewRepo =
        new(AppConfig.Current.ConnectionStrings.DefaultConnection);

    protected override async Task OnInitializedAsync()
    {
        Databases = await DbRepo.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Task.Delay(100);

        await LoadStateAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadStateAsync()
    {
        var dbStr = await JSRuntime.InvokeAsync<string>("stateManager.load", "dbId");
        var dom = await JSRuntime.InvokeAsync<string>("stateManager.load", "dom");
        var objStr = await JSRuntime.InvokeAsync<string>("stateManager.load", "objId");

        if (!int.TryParse(dbStr, out var dbId))
            return;

        SelectedDatabaseId = dbId;
        Domains = await DbRepo.GetDomainsAsync(dbId);

        if (!string.IsNullOrWhiteSpace(dom))
        {
            SelectedDomain = dom;

            var raw = await SchemaRepo.GetByDatabaseAsync(dbId);

            var filtered = raw.Where(x => x.Domain == SelectedDomain)
                              .OrderByDescending(x => x.IsBaseObject)
                              .ThenBy(x => x.BusinessName)
                              .ToList();

            var baseItems = filtered.Where(x => x.IsBaseObject).ToList();
            var derivedItems = filtered.Where(x => !x.IsBaseObject).ToList();

            DisplayObjects.Clear();

            DisplayObjects.Add(new DisplaySchemaObject
            {
                SchemaObjectId = -1,
                DisplayName = "━━ BASE OBJECTS ━━",
                IsHeader = true
            });

            DisplayObjects.AddRange(baseItems.Select(x => new DisplaySchemaObject
            {
                SchemaObjectId = x.SchemaObjectId,
                DisplayName = x.BusinessName,
                IsBaseObject = true
            }));

            if (derivedItems.Any())
            {
                DisplayObjects.Add(new DisplaySchemaObject
                {
                    SchemaObjectId = -2,
                    DisplayName = "━━ DERIVED VIEWS ━━",
                    IsHeader = true
                });

                DisplayObjects.AddRange(derivedItems.Select(x => new DisplaySchemaObject
                {
                    SchemaObjectId = x.SchemaObjectId,
                    DisplayName = x.BusinessName,
                    IsBaseObject = false
                }));
            }
        }

        if (int.TryParse(objStr, out var objId) && objId > 0)
        {
            SelectedObjectId = objId;
            LastValidObjectId = objId;

            IsLoading = true;
            SelectedObject = await SchemaRepo.GetByIdAsync(objId);
            Columns = await SchemaRepo.GetColumnsAsync(objId);
            IsLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveStateAsync()
    {
        await JSRuntime.InvokeVoidAsync("stateManager.save", "dbId", SelectedDatabaseId?.ToString());
        await JSRuntime.InvokeVoidAsync("stateManager.save", "dom", SelectedDomain);
        await JSRuntime.InvokeVoidAsync("stateManager.save", "objId", SelectedObjectId?.ToString());
    }

    private async Task OnDatabaseChanged(object value)
    {
        if (!int.TryParse(value?.ToString(), out var dbId))
            return;

        SelectedDatabaseId = dbId;

        ClearChildSelections(true);

        Domains = await DbRepo.GetDomainsAsync(dbId);

        await SaveStateAsync();
    }

    private async Task OnDomainChanged(object value)
    {
        SelectedDomain = value?.ToString() ?? "";

        DisplayObjects.Clear();
        SelectedObjectId = null;
        LastValidObjectId = null;
        SelectedObject = null;
        Columns.Clear();

        if (SelectedDatabaseId.HasValue &&
            !string.IsNullOrWhiteSpace(SelectedDomain))
        {
            var raw = await SchemaRepo.GetByDatabaseAsync(SelectedDatabaseId.Value);

            var filtered = raw.Where(x => x.Domain == SelectedDomain)
                              .OrderByDescending(x => x.IsBaseObject)
                              .ThenBy(x => x.BusinessName)
                              .ToList();

            var baseItems = filtered.Where(x => x.IsBaseObject).ToList();
            var derivedItems = filtered.Where(x => !x.IsBaseObject).ToList();

            DisplayObjects.Add(new DisplaySchemaObject
            {
                SchemaObjectId = -1,
                DisplayName = "━━ BASE OBJECTS ━━",
                IsHeader = true
            });

            DisplayObjects.AddRange(baseItems.Select(x => new DisplaySchemaObject
            {
                SchemaObjectId = x.SchemaObjectId,
                DisplayName = x.BusinessName,
                IsBaseObject = true
            }));

            if (derivedItems.Any())
            {
                DisplayObjects.Add(new DisplaySchemaObject
                {
                    SchemaObjectId = -2,
                    DisplayName = "━━ DERIVED VIEWS ━━",
                    IsHeader = true
                });

                DisplayObjects.AddRange(derivedItems.Select(x => new DisplaySchemaObject
                {
                    SchemaObjectId = x.SchemaObjectId,
                    DisplayName = x.BusinessName,
                    IsBaseObject = false
                }));
            }
        }

        await SaveStateAsync();
    }



    private async Task OnObjectChanged(object value)
    {
        if (!int.TryParse(value?.ToString(), out var objId))
        {
            SelectedObjectId = null;
            LastValidObjectId = null;
            SelectedObject = null;
            Columns.Clear();
            await SaveStateAsync();
            return;
        }

        if (objId <= 0)
        {
            SelectedObjectId = LastValidObjectId;
            await InvokeAsync(StateHasChanged);
            return;
        }

        SelectedObjectId = objId;
        LastValidObjectId = objId;

        IsLoading = true;

        SelectedObject = await SchemaRepo.GetByIdAsync(objId);
        Columns = await SchemaRepo.GetColumnsAsync(objId);

        IsLoading = false;

        await SaveStateAsync();
    }



    private void ClearChildSelections(bool keepDb = false)
    {
        if (!keepDb)
        {
            SelectedDatabaseId = null;
            Domains.Clear();
        }

        SelectedDomain = "";
        DisplayObjects.Clear();
        SelectedObjectId = null;
        LastValidObjectId = null;
        SelectedObject = null;
        Columns.Clear();
    }

    private async Task ShowViewDefinition()
    {
        if (SelectedObject == null)
            return;

        var result = await ViewRepo.GetViewDefinitionAsync(
            SelectedObject.SourceDatabaseName,
            SelectedObject.SourceSchemaName,
            SelectedObject.SourceObjectName);

        string sqlContent = string.IsNullOrWhiteSpace(result?.Definition)
            ? SQLViewMock.SQLView
            : result.Definition;

        string cleanedSql = ViewRepo.CleanSqlDefinition(sqlContent);

        await DialogService.OpenAsync<ViewSQLDialog>(
            $"SQL Source: {SelectedObject.SourceObjectName}",
            new Dictionary<string, object>
            {
                { "SqlContent", cleanedSql }
            });
    }

    private async Task ShowParserViewDefinition()
    {
        if (SelectedObject == null)
            return;

        try
        {
            var parserService = new ViewParsingService(
                AppConfig.Current.ConnectionStrings.DefaultConnection);

            string sqlContent = parserService.GetViewSql(
                SelectedObject.SourceDatabaseName ?? string.Empty,
                SelectedObject.SourceSchemaName,
                SelectedObject.SourceObjectName) ?? string.Empty;

            if (string.IsNullOrWhiteSpace(sqlContent))
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Parser SQL unavailable",
                    "The parser service did not return SQL for the selected view.");
                return;
            }

            await DialogService.OpenAsync<ViewSQLDialog>(
                $"Parser SQL: {SelectedObject.SourceObjectName}",
                new Dictionary<string, object>
                {
                    { "SqlContent", sqlContent },
                    { "IsMock", false }
                });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Parser SQL failed",
                ex.Message,
                5000);
        }
    }

    private async Task ShowParserTables()
    {
        if (SelectedObject == null)
            return;

        try
        {
            var parserService = new ViewParsingService(
                AppConfig.Current.ConnectionStrings.DefaultConnection);

            var tables = parserService.GetSourceTableDtos(
                SelectedObject.SourceDatabaseName ?? string.Empty,
                SelectedObject.SourceSchemaName,
                SelectedObject.SourceObjectName);

            if (tables.Count == 0)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Parser tables unavailable",
                    "The parser service did not return any source tables for the selected view.");
                return;
            }

            await DialogService.OpenAsync<DynamicGridDialog>(
                $"Parser Tables: {SelectedObject.SourceObjectName} ({tables.Count} total)",
                new Dictionary<string, object>
                {
                    { "Items", tables.Cast<object>().ToList() },
                    { "EmptyMessage", "The parser service did not return any source tables for the selected view." }
                },
                new DialogOptions()
                {
                    Width = "1200px",
                    Height = "800px",
                    Resizable = true,
                    Draggable = true
                });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Parser tables failed",
                ex.Message,
                5000);
        }
    }

    private async Task ShowParserColumns()
    {
        if (SelectedObject == null)
            return;

        try
        {
            var parserService = new ViewParsingService(
                AppConfig.Current.ConnectionStrings.DefaultConnection);

            var columns = parserService.GetViewColumnDtos(
                SelectedObject.SourceDatabaseName ?? string.Empty,
                SelectedObject.SourceSchemaName,
                SelectedObject.SourceObjectName);

            if (columns.Count == 0)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Parser columns unavailable",
                    "The parser service did not return any parsed columns for the selected view.");
                return;
            }

            await DialogService.OpenAsync<DynamicGridDialog>(
                $"Parser Columns: {SelectedObject.SourceObjectName} ({columns.Count} total)",
                new Dictionary<string, object>
                {
                    { "Items", columns.Cast<object>().ToList() },
                    { "EmptyMessage", "The parser service did not return any parsed columns for the selected view." }
                },
                new DialogOptions()
                {
                    Width = "1200px",
                    Height = "800px",
                    Resizable = true,
                    Draggable = true
                });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Parser columns failed",
                ex.Message,
                5000);
        }
    }

    private async Task OpenHelp(string id)
    {
        await DialogService.OpenAsync<HelpDialog>(
            "Schema Studio Help Console",
            new Dictionary<string, object>
            {
            { "Databases", Databases },
            { "InitialSubjectId", id }
            },
            new DialogOptions()
            {
                Width = "1200px",
                Height = "800px",
                Resizable = true,
                Draggable = true
            });
    }

    private async Task OpenRowDetails(SchemaObjectColumnModel col)
    {
        await DialogService.OpenAsync<DynamicDetailForm>(
            $"Details: {col.SourceColumnName}",
            new Dictionary<string, object>
            {
            { "Model", col }
            },
            new DialogOptions()
            {
                Width = "900px",
                Height = "800px",
                Resizable = true,
                Draggable = true
            });
    }

    private Task EnterAdminMode()
    {
        NavigationManager.NavigateTo("/help-editor");
        return Task.CompletedTask;
    }
}
