@page "/base-view-generator"

@using Radzen
@using Radzen.Blazor
@using SchemaStudio.Data.Models
@using SchemaStudio.Data.Repositories
@using SchemaStudio.AIHelpers
@using SchemaStudioWebViewer.Data
@using SchemaStudioWebViewer.Models

@inject DatabaseRepository DatabaseRepository
@inject TableSchemaSmoRepository TableSchemaRepository
@inject IJSRuntime JSRuntime

@attribute [FileVersion("1.11")]
@attribute [AIFileContext("Components/Pages/BaseViewGenerator/BaseViewGenerator.razor", "Maintenance page for generating deterministic base-view SQL from SQL Server table metadata and foreign-key relationships.", Responsibilities = "Lets a user select a source database/schema/table, review M-to-1 FK relationships, override join inclusion/type, and copy generated CREATE OR ALTER VIEW SQL.", Nuances = "The page generates mechanical SQL only; business metadata comments are intentionally optional placeholders because final annotations are reviewed outside this automation.", RelatedFiles = "Repositories/TableSchemaSmoRepository.cs", LastReviewed = "2026-05-07")]

<PageTitle>Base View Generator</PageTitle>

<div class="bvg-page">
    @if (IsBusy)
    {
        <div class="bvg-busy-overlay" role="status" aria-live="polite">
            <div class="bvg-spinner"></div>
            <div>Loading schema metadata...</div>
        </div>
    }

    <section class="bvg-header">
        <div>
            <h1>Base View Generator</h1>
            <p>Generate deterministic base view SQL from table metadata and M-to-1 foreign keys.</p>
        </div>
        <div class="bvg-header-actions">
            <button type="button" class="bvg-button secondary" @onclick="RefreshMetadataAsync" disabled="@IsBusy">Refresh Metadata</button>
            <button type="button" class="bvg-button primary" @onclick="CopySqlAsync" disabled="@string.IsNullOrWhiteSpace(GeneratedSql)">Copy SQL</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="bvg-alert">@ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="bvg-status">@StatusMessage</div>
    }

    <div class="bvg-layout">
        <section class="bvg-panel bvg-source-panel">
            <header class="bvg-panel-header">Source Table</header>
            <div class="bvg-form-grid">
                <label>
                    <span>Source Database</span>
                    <RadzenDropDown TValue="string"
                                    Data="@Databases"
                                    TextProperty="DatabaseName"
                                    ValueProperty="DatabaseName"
                                    @bind-Value="@SelectedDatabaseName"
                                    Change="@OnDatabaseChangedAsync"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Disabled="@IsBusy"
                                    Placeholder="Select database"
                                    Style="width: 100%;" />
                </label>

                <label>
                    <span>Source Schema</span>
                    <input value="@SelectedSchemaName" @oninput="OnSchemaNameChanged" placeholder="dbo" disabled="@IsBusy" />
                </label>

                <label>
                    <span>Source Table</span>
                    <div class="bvg-table-entry">
                        <input value="@SelectedTableName" @oninput="OnTableNameChanged" placeholder="Type table name" disabled="@IsBusy" />
                        <button type="button"
                                class="bvg-button secondary"
                                @onclick="LoadSelectedTableAsync"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedSchemaName) || string.IsNullOrWhiteSpace(SelectedTableName))">
                            Load
                        </button>
                    </div>
                </label>

                <label>
                    <span>Base Alias</span>
                    <input value="@BaseAlias" @oninput="OnBaseAliasChanged" />
                </label>
            </div>

            <div class="bvg-target">
                <h2>Target View</h2>
                <div class="bvg-form-grid">
                    <label>
                        <span>Target Database</span>
                        <input value="@TargetDatabaseName" @oninput="OnTargetDatabaseChanged" />
                    </label>
                    <label>
                        <span>Target Schema</span>
                        <input value="@TargetSchemaName" @oninput="OnTargetSchemaChanged" />
                    </label>
                    <label class="bvg-wide">
                        <span>View Name</span>
                        <input value="@TargetViewName" @oninput="OnTargetViewNameChanged" />
                    </label>
                </div>
                <div class="bvg-preview-line">@TargetViewPreview</div>
            </div>

            <div class="bvg-options">
                <label><input type="checkbox" @bind="IncludeLookupDisplayColumns" @bind:after="RegenerateSql" /> Include lookup display columns</label>
                <label><input type="checkbox" @bind="IgnoreSelfJoins" @bind:after="RefreshMetadataAsync" /> Ignore self joins</label>
                <label><input type="checkbox" @bind="IncludeMetadataPlaceholders" @bind:after="RegenerateSql" /> Include metadata placeholders</label>
            </div>

        </section>

        <section class="bvg-panel bvg-workspace-panel">
            <header class="bvg-tabs" role="tablist" aria-label="Base view generator workspace">
                <button type="button" class="@TabClass("sql")" @onclick='() => ActiveWorkspaceTab = "sql"'>Generated SQL</button>
                <button type="button" class="@TabClass("columns")" @onclick='() => ActiveWorkspaceTab = "columns"'>Columns (@Columns.Count)</button>
                <button type="button" class="@TabClass("relationships")" @onclick='() => ActiveWorkspaceTab = "relationships"'>Relationships (@Relationships.Count)</button>
            </header>

            <div class="bvg-tab-body">
                @if (ActiveWorkspaceTab == "sql")
                {
                    <pre class="bvg-sql-output">@GeneratedSql</pre>
                }
                else if (ActiveWorkspaceTab == "columns")
                {
                    <div class="bvg-column-filter">
                        <input placeholder="Filter columns" value="@ColumnFilter" @oninput="OnColumnFilterChanged" />
                    </div>
                    <div class="bvg-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Include</th>
                                    <th>Column</th>
                                    <th>Data Type</th>
                                    <th>Nullable</th>
                                    <th>Key Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var column in FilteredColumns)
                                {
                                    <tr>
                                        <td><input type="checkbox" @bind="column.Include" @bind:after="RegenerateSql" /></td>
                                        <td>@column.ColumnName</td>
                                        <td>@column.DataType</td>
                                        <td>@(column.IsNullable ? "Yes" : "No")</td>
                                        <td>@column.KeyRole</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <section class="bvg-relationships">
                        <h2>Detected M-to-1 Relationships (@Relationships.Count)</h2>
                        <div class="bvg-note">
                            @BaseAlias is the many-side table. Join defaults are inferred from FK column nullability; override each relationship before copying SQL.
                        </div>
                        <div class="bvg-table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Include</th>
                                        <th>FK Column</th>
                                        <th>Referenced Table</th>
                                        <th>Required</th>
                                        <th>Join</th>
                                        <th>Display Column</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var relationship in Relationships)
                                    {
                                        <tr>
                                            <td><input type="checkbox" @bind="relationship.Include" @bind:after="RegenerateSql" /></td>
                                            <td>@relationship.LocalColumns</td>
                                            <td>@QualifiedName(SelectedDatabaseName, relationship.ReferencedSchemaName, relationship.ReferencedTableName)</td>
                                            <td>@(relationship.IsRequired ? "Yes" : "No")</td>
                                            <td>
                                                <select @bind="relationship.SelectedJoinType" @bind:after="RegenerateSql">
                                                    <option>INNER JOIN</option>
                                                    <option>LEFT JOIN</option>
                                                </select>
                                            </td>
                                            <td>
                                                <div class="bvg-display-cell">
                                                    <input type="checkbox" @bind="relationship.IncludeDisplayColumn" @bind:after="RegenerateSql" disabled="@string.IsNullOrWhiteSpace(relationship.DisplayColumnName)" />
                                                    <input value="@relationship.DisplayColumnName" @oninput="args => OnRelationshipDisplayColumnChanged(relationship, args)" disabled="@(!relationship.IncludeDisplayColumn)" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private const string DefaultTargetDatabaseName = "VVGBI_Integrations";
    private const string DefaultTargetSchemaName = "dbo";

    private bool IsBusy;
    private bool IncludeLookupDisplayColumns = true;
    private bool IgnoreSelfJoins = true;
    private bool IncludeMetadataPlaceholders;
    private string ErrorMessage = "";
    private string StatusMessage = "";
    private string SelectedDatabaseName = "";
    private string SelectedSchemaName = "";
    private string SelectedTableName = "";
    private string BaseAlias = "";
    private string TargetDatabaseName = DefaultTargetDatabaseName;
    private string TargetSchemaName = DefaultTargetSchemaName;
    private string TargetViewName = "";
    private string ColumnFilter = "";
    private string GeneratedSql = "";
    private string ActiveWorkspaceTab = "sql";

    private List<DatabaseDefinition> Databases = new();
    private List<TableSchemaColumnInfo> Columns = new();
    private List<TableSchemaRelationshipInfo> Relationships = new();

    private string TargetViewPreview =>
        string.IsNullOrWhiteSpace(TargetViewName)
            ? "Select a table to generate a target view name."
            : $"CREATE OR ALTER VIEW {QualifiedName(TargetDatabaseName, TargetSchemaName, TargetViewName)}";

    private IEnumerable<TableSchemaColumnInfo> FilteredColumns =>
        string.IsNullOrWhiteSpace(ColumnFilter)
            ? Columns
            : Columns.Where(column => column.ColumnName.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase)
                                   || column.DataType.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase)
                                   || column.KeyRole.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase));

    private string TabClass(string tabName) =>
        ActiveWorkspaceTab == tabName
            ? "bvg-tab active"
            : "bvg-tab";

    protected override async Task OnInitializedAsync()
    {
        await RunPageOperationAsync(async () =>
        {
            Databases = (await DatabaseRepository.GetAllAsync()).ToList();
            StatusMessage = Databases.Count == 0
                ? "No SchemaStudio database definitions are available."
                : $"Loaded {Databases.Count} SchemaStudio database definitions.";
        }, "Failed to load databases.");
    }

    private async Task OnDatabaseChangedAsync(object value)
    {
        SelectedDatabaseName = value?.ToString() ?? "";
        SelectedTableName = "";
        Columns.Clear();
        Relationships.Clear();
        GeneratedSql = "";
        StatusMessage = "";

        var selectedDatabase = Databases.FirstOrDefault(database => string.Equals(database.DatabaseName, SelectedDatabaseName, StringComparison.OrdinalIgnoreCase));
        SelectedSchemaName = string.IsNullOrWhiteSpace(selectedDatabase?.DefaultSchema)
            ? DefaultTargetSchemaName
            : selectedDatabase.DefaultSchema;

        StatusMessage = $"Schema [{SelectedSchemaName}] selected from database definition. Type a table name and click Load.";
    }

    private void OnSchemaNameChanged(ChangeEventArgs args)
    {
        SelectedSchemaName = args.Value?.ToString()?.Trim() ?? "";
        SelectedTableName = "";
        Columns.Clear();
        Relationships.Clear();
        GeneratedSql = "";
        StatusMessage = string.IsNullOrWhiteSpace(SelectedSchemaName)
            ? "Select a source schema before loading a table."
            : $"Schema [{SelectedSchemaName}] selected. Type a table name and click Load.";
    }

    private void OnTableNameChanged(ChangeEventArgs args)
    {
        SelectedTableName = args.Value?.ToString()?.Trim() ?? "";
        BaseAlias = SelectedTableName;
        Columns.Clear();
        Relationships.Clear();
        GeneratedSql = "";
        TargetViewName = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedTableName)
            ? ""
            : $"SS_{SelectedDatabaseName}_{SelectedTableName}";
        StatusMessage = string.IsNullOrWhiteSpace(SelectedTableName)
            ? "Type a table name and click Load."
            : $"Ready to check [{SelectedDatabaseName}].[{SelectedSchemaName}].[{SelectedTableName}].";
    }

    private async Task LoadSelectedTableAsync()
    {
        BaseAlias = SelectedTableName;
        TargetViewName = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedTableName)
            ? ""
            : $"SS_{SelectedDatabaseName}_{SelectedTableName}";
        await LoadTableDetailsAsync();
    }

    private async Task RefreshMetadataAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedTableName))
        {
            StatusMessage = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedSchemaName)
                ? "Select a source database and schema, then type a table name."
                : $"Ready to check [{SelectedDatabaseName}].[{SelectedSchemaName}]. Type a table name and click Load.";
            return;
        }

        await LoadTableDetailsAsync();
    }

    private async Task LoadTableDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabaseName) ||
            string.IsNullOrWhiteSpace(SelectedSchemaName) ||
            string.IsNullOrWhiteSpace(SelectedTableName))
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var details = await TableSchemaRepository.GetTableDetailsAsync(SelectedDatabaseName, SelectedSchemaName, SelectedTableName);
            Columns = details.Columns.ToList();
            Relationships = details.Relationships
                .Where(relationship => !IgnoreSelfJoins ||
                    !string.Equals(relationship.ReferencedSchemaName, SelectedSchemaName, StringComparison.OrdinalIgnoreCase) ||
                    !string.Equals(relationship.ReferencedTableName, SelectedTableName, StringComparison.OrdinalIgnoreCase))
                .ToList();
            RegenerateSql();
            StatusMessage = $"Loaded {Columns.Count} columns and {Relationships.Count} M-to-1 relationships from [{SelectedDatabaseName}].[{SelectedSchemaName}].[{SelectedTableName}].";
        }, $"Failed to load table details from [{SelectedDatabaseName}].[{SelectedSchemaName}].[{SelectedTableName}].");
    }

    private void OnBaseAliasChanged(ChangeEventArgs args)
    {
        BaseAlias = args.Value?.ToString() ?? "";
        RegenerateSql();
    }

    private void OnTargetDatabaseChanged(ChangeEventArgs args)
    {
        TargetDatabaseName = args.Value?.ToString() ?? "";
        RegenerateSql();
    }

    private void OnTargetSchemaChanged(ChangeEventArgs args)
    {
        TargetSchemaName = args.Value?.ToString() ?? "";
        RegenerateSql();
    }

    private void OnTargetViewNameChanged(ChangeEventArgs args)
    {
        TargetViewName = args.Value?.ToString() ?? "";
        RegenerateSql();
    }

    private void OnRelationshipDisplayColumnChanged(TableSchemaRelationshipInfo relationship, ChangeEventArgs args)
    {
        relationship.DisplayColumnName = args.Value?.ToString();
        RegenerateSql();
    }

    private void OnColumnFilterChanged(ChangeEventArgs args)
    {
        ColumnFilter = args.Value?.ToString() ?? "";
    }

    private void RegenerateSql()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabaseName) ||
            string.IsNullOrWhiteSpace(SelectedSchemaName) ||
            string.IsNullOrWhiteSpace(SelectedTableName) ||
            string.IsNullOrWhiteSpace(BaseAlias) ||
            string.IsNullOrWhiteSpace(TargetDatabaseName) ||
            string.IsNullOrWhiteSpace(TargetSchemaName) ||
            string.IsNullOrWhiteSpace(TargetViewName))
        {
            GeneratedSql = "";
            return;
        }

        var lines = new List<string>
        {
            $"CREATE OR ALTER VIEW {QualifiedName(TargetDatabaseName, TargetSchemaName, TargetViewName)}",
            "AS",
            "SELECT"
        };

        var projectionLines = BuildProjectionLines().ToList();
        if (projectionLines.Count == 0)
        {
            lines.Add("      -- Select at least one column.");
        }
        else
        {
            lines.AddRange(projectionLines);
        }

        lines.Add("");
        lines.Add($"FROM {QualifiedName(SelectedDatabaseName, SelectedSchemaName, SelectedTableName)} AS {QuoteIdentifier(BaseAlias)}");

        foreach (var relationship in Relationships.Where(relationship => relationship.Include))
        {
            lines.AddRange(BuildJoinLines(relationship));
        }

        GeneratedSql = string.Join(Environment.NewLine, lines);
    }

    private IEnumerable<string> BuildProjectionLines()
    {
        var first = true;
        var relationshipColumnNames = Relationships
            .SelectMany(relationship => relationship.Columns.Select(column => column.LocalColumnName))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var column in Columns.Where(column => column.Include && !relationshipColumnNames.Contains(column.ColumnName)))
        {
            yield return $"{ProjectionPrefix(first)}{QuoteIdentifier(BaseAlias)}.{QuoteIdentifier(column.ColumnName)}{BuildMetadataPlaceholder(column.ColumnName)}";
            first = false;
        }

        var emittedRelationshipColumns = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var relationshipLines = new List<string>();

        foreach (var relationship in Relationships)
        {
            foreach (var pair in relationship.Columns)
            {
                if (!emittedRelationshipColumns.Add(pair.LocalColumnName))
                {
                    continue;
                }

                var column = Columns.FirstOrDefault(candidate => string.Equals(candidate.ColumnName, pair.LocalColumnName, StringComparison.OrdinalIgnoreCase));
                if (column?.Include != true)
                {
                    continue;
                }

                relationshipLines.Add($"{ProjectionPrefix(first)}{QuoteIdentifier(BaseAlias)}.{QuoteIdentifier(pair.LocalColumnName)}{BuildMetadataPlaceholder(pair.LocalColumnName)}");
                first = false;
            }

            if (!IncludeLookupDisplayColumns ||
                !relationship.Include ||
                !relationship.IncludeDisplayColumn ||
                string.IsNullOrWhiteSpace(relationship.DisplayColumnName))
            {
                continue;
            }

            var alias = BuildLookupAlias(relationship);
            var columnAlias = BuildLookupProjectionAlias(relationship);
            relationshipLines.Add($"{ProjectionPrefix(first)}{QuoteIdentifier(alias)}.{QuoteIdentifier(relationship.DisplayColumnName!)} AS {QuoteIdentifier(columnAlias)}{BuildMetadataPlaceholder(columnAlias)}");
            first = false;
        }

        if (relationshipLines.Count > 0)
        {
            yield return "";
            foreach (var line in relationshipLines)
            {
                yield return line;
            }
        }
    }

    private IEnumerable<string> BuildJoinLines(TableSchemaRelationshipInfo relationship)
    {
        var alias = BuildLookupAlias(relationship);
        var predicates = relationship.Columns
            .Select(pair => $"{QuoteIdentifier(alias)}.{QuoteIdentifier(pair.ReferencedColumnName)} = {QuoteIdentifier(BaseAlias)}.{QuoteIdentifier(pair.LocalColumnName)}");
        yield return $"{relationship.SelectedJoinType} {QualifiedName(SelectedDatabaseName, relationship.ReferencedSchemaName, relationship.ReferencedTableName)} AS {QuoteIdentifier(alias)} ON {string.Join(" AND ", predicates)}";
    }

    private string BuildLookupAlias(TableSchemaRelationshipInfo relationship)
    {
        var referencedTable = relationship.ReferencedTableName;
        var duplicateCount = Relationships
            .Where(candidate => string.Equals(candidate.ReferencedSchemaName, relationship.ReferencedSchemaName, StringComparison.OrdinalIgnoreCase))
            .Where(candidate => string.Equals(candidate.ReferencedTableName, relationship.ReferencedTableName, StringComparison.OrdinalIgnoreCase))
            .TakeWhile(candidate => !ReferenceEquals(candidate, relationship))
            .Count();

        return duplicateCount == 0
            ? referencedTable
            : $"{referencedTable}_{relationship.LocalColumns.Replace(",", "_", StringComparison.Ordinal).Replace(" ", "", StringComparison.Ordinal)}";
    }

    private static string BuildLookupProjectionAlias(TableSchemaRelationshipInfo relationship)
    {
        var localColumn = relationship.Columns.FirstOrDefault()?.LocalColumnName ?? relationship.ReferencedTableName;
        var cleaned = localColumn.EndsWith("Id", StringComparison.OrdinalIgnoreCase)
            ? localColumn[..^2]
            : localColumn;

        return $"{cleaned}Description";
    }

    private string BuildMetadataPlaceholder(string columnName) =>
        IncludeMetadataPlaceholders
            ? " /*@BusinessName:  @BusinessDescription:  */"
            : string.Empty;

    private static string ProjectionPrefix(bool first) =>
        first ? "      " : "    , ";

    private static string QualifiedName(params string?[] parts) =>
        string.Join(".", parts.Where(part => !string.IsNullOrWhiteSpace(part)).Select(part => QuoteIdentifier(part!)));

    private static string QuoteIdentifier(string identifier) =>
        $"[{identifier.Replace("]", "]]", StringComparison.Ordinal)}]";

    private async Task CopySqlAsync()
    {
        if (!string.IsNullOrWhiteSpace(GeneratedSql))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedSql);
        }
    }

    private async Task RunPageOperationAsync(Func<Task> operation, string failureMessage)
    {
        IsBusy = true;
        ErrorMessage = "";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            await operation();
        }
        catch (Exception ex)
        {
            StatusMessage = "";
            ErrorMessage = $"{failureMessage} {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
