@page "/base-view-generator"

@using Radzen
@using Radzen.Blazor
@using SchemaStudio.Data.Models
@using SchemaStudio.Data.Repositories
@using SchemaStudio.AIHelpers
@using SchemaStudioWebViewer.Data
@using SchemaStudioWebViewer.Models
@using SchemaStudioWebViewer.Utils

@inject DatabaseRepository DatabaseRepository
@inject TableSchemaSmoRepository TableSchemaRepository
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject TooltipService TooltipService

@attribute [FileVersion("1.51")]
@attribute [AIFileContext("Components/Pages/BaseViewGenerator/BaseViewGenerator.razor", "Maintenance page for generating deterministic base-view SQL from SQL Server table metadata and foreign-key relationships.", Responsibilities = "Lets a user select a source database/schema/table, review M-to-1 FK relationships, override join inclusion/type, and copy generated CREATE OR ALTER VIEW SQL.", Nuances = "The page generates mechanical SQL only; business metadata comments are intentionally optional placeholders because final annotations are reviewed outside this automation.", RelatedFiles = "Repositories/TableSchemaSmoRepository.cs", LastReviewed = "2026-05-07")]

<PageTitle>Base View Generator</PageTitle>

<div class="bvg-page">
    @if (IsBusy)
    {
        <div class="bvg-busy-overlay" role="status" aria-live="polite">
            <div class="bvg-spinner"></div>
            <div>Loading schema metadata...</div>
        </div>
    }

    <section class="bvg-header">
        <div>
            <h1>Base View Generator</h1>
            <p>Generate deterministic base view SQL from table metadata and M-to-1 foreign keys.</p>
        </div>
        <div class="bvg-header-actions">
            <button type="button" class="bvg-button secondary" @onclick="RefreshMetadataAsync" disabled="@IsBusy">Refresh Metadata</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="bvg-status">
            @StatusMessage
            @if (SqlDirty)
            {
                <span class="bvg-dirty-note">SQL has pending changes. Click Regenerate SQL.</span>
            }
        </div>
    }

    <div class="bvg-layout">
        <section class="bvg-panel bvg-source-panel">
            <header class="bvg-panel-header">Source Table</header>
            <div class="bvg-form-grid">
                <label>
                    <span>Source Database</span>
                    <RadzenDropDown TValue="string"
                                    Data="@Databases"
                                    TextProperty="DatabaseName"
                                    ValueProperty="DatabaseName"
                                    @bind-Value="@SelectedDatabaseName"
                                    Change="@OnDatabaseChangedAsync"
                                    Disabled="@IsBusy"
                                    Placeholder="Select database"
                                    Style="width: 100%;" />
                </label>

                <label>
                    <span>Source Schema</span>
                    <input value="@SelectedSchemaName" @oninput="OnSchemaNameChanged" placeholder="dbo" disabled="@IsBusy" />
                </label>

                <label>
                    <span>Source Table</span>
                    <div class="bvg-table-entry">
                        <input value="@SelectedTableName" @oninput="OnTableNameChanged" placeholder="Type table name" disabled="@IsBusy" />
                        <button type="button"
                                class="bvg-button secondary"
                                @onclick="LoadSelectedTableAsync"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedSchemaName) || string.IsNullOrWhiteSpace(SelectedTableName))">
                            Load
                        </button>
                    </div>
                </label>

                <label>
                    <span>Base Alias</span>
                    <input value="@BaseAlias" @oninput="OnBaseAliasChanged" />
                </label>
            </div>

            <div class="bvg-target">
                <h2>Target View</h2>
                <div class="bvg-form-grid">
                    <label>
                        <span>Target Database</span>
                        <input value="@TargetDatabaseName" @oninput="OnTargetDatabaseChanged" />
                    </label>
                    <label>
                        <span>Target Schema</span>
                        <input value="@TargetSchemaName" @oninput="OnTargetSchemaChanged" />
                    </label>
                    <label class="bvg-wide">
                        <span>View Name</span>
                        <input value="@TargetViewName" @oninput="OnTargetViewNameChanged" />
                    </label>
                </div>
                <div class="bvg-preview-line">@TargetViewPreview</div>
            </div>

            <section class="bvg-source-info">
                <header class="bvg-mini-tabs" role="tablist" aria-label="Base view generator source options">
                    <button type="button" class="@SourceInfoTabClass("options")" @onclick='() => SetSourceInfoTab("options")'>Include Options</button>
                    <button type="button" class="@SourceInfoTabClass("children")" @onclick='() => SetSourceInfoTab("children")'>Known Child Tables (@ChildRelationships.Count)</button>
                </header>

                <div class="bvg-source-info-body">
                    @if (ActiveSourceInfoTab == "options")
                    {
                        <div class="bvg-options">
                            <label><input type="checkbox" checked="@IncludeLookupDisplayColumns" @onchange="OnIncludeLookupDisplayColumnsChanged" /> Include lookup display columns @HelpIcon("When checked, generated SQL joins to one-side lookup tables and projects their selected display columns. When unchecked, FK columns remain in the SELECT but lookup joins and lookup display columns are omitted.")</label>
                            <label><input type="checkbox" checked="@IgnoreSelfJoins" @onchange="OnIgnoreSelfJoinsChanged" /> Ignore self joins @HelpIcon("Hides relationships where the source table references itself. The source table FK columns are still available in the Columns tab.")</label>
                            <label><input type="checkbox" checked="@IgnoreRelationshipsWithoutDisplay" @onchange="OnIgnoreRelationshipsWithoutDisplayChanged" /> Ignore FK relationships without display columns @HelpIcon("Keeps the FK columns but suppresses lookup joins when no configured display column is available on the referenced table.")</label>
                            <label><input type="checkbox" checked="@IncludeMetadataPlaceholders" @onchange="OnIncludeMetadataPlaceholdersChanged" /> Include metadata placeholders @HelpIcon("Adds Schema Studio metadata comment placeholders to generated projection lines. FK and lookup display columns include DisableInheritance by default.")</label>
                            <label>
                                Output shape @HelpIcon("CTE wraps the generated table SQL in a TableName_Source unit and projects the final view from that named source. Standard emits one flat SELECT.")
                                <select value="@OutputShape" @onchange="OnOutputShapeChanged">
                                    <option value="@OutputShapeCte">CTE</option>
                                    <option value="@OutputShapeStandard">Standard</option>
                                </select>
                            </label>
                        </div>
                    }
                    else
                    {
                        <section class="bvg-child-relationships">
                            <div class="bvg-note">
                                These tables reference @SelectedTableDisplayName. This is informational only and does not affect generated SQL.
                            </div>
                            <div class="bvg-table-wrap bvg-child-table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Table</th>
                                            <th>Join Clause</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ChildRelationships.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="2" class="bvg-empty-cell">No child tables loaded.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var childRelationship in ChildRelationships)
                                            {
                                                <tr>
                                                    <td>@QualifiedName(SelectedDatabaseName, childRelationship.ChildSchemaName, childRelationship.ChildTableName)</td>
                                                    <td class="bvg-join-clause">@BuildChildJoinClause(childRelationship)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </div>
            </section>

        </section>

        <section class="bvg-panel bvg-workspace-panel">
            <header class="bvg-tabs" role="tablist" aria-label="Base view generator workspace">
                <button type="button" class="@TabClass("sql")" @onclick='() => SetWorkspaceTab("sql")'>Generated SQL</button>
                <button type="button" class="@TabClass("projection")" @onclick='() => SetWorkspaceTab("projection")'>Projection (@Columns.Count / @Relationships.Count)</button>
            </header>

            <div class="bvg-tab-body">
                @if (ActiveWorkspaceTab == "sql")
                {
                    <div @key="SqlRenderVersion" class="sql-code-container bvg-sql-output" style="--sql-keyword-color: #0000ff; --sql-comment-color: #008000; --sql-string-color: #a31515;">
                        <pre class="language-sql"><code class="language-sql">@GeneratedSql</code></pre>
                    </div>
                }
                else
                {
                    <div class="bvg-column-filter">
                        <input placeholder="Filter columns or relationships" value="@ColumnFilter" @oninput="OnColumnFilterChanged" />
                    </div>
                    <div class="bvg-projection-toolbar">
                        <button type="button" class="bvg-button secondary" @onclick="ExpandAllProjectionGroups">Expand All</button>
                        <button type="button" class="bvg-button secondary" @onclick="CollapseAllProjectionGroups">Collapse All</button>
                    </div>
                    <div class="bvg-projection-tree">
                        <section class="bvg-projection-group">
                            <div class="bvg-group-header">
                                <button type="button" class="bvg-group-toggle" @onclick="ToggleSourceGroup">@(SourceGroupExpanded ? "▾" : "▸")</button>
                                <strong>FROM @QualifiedName(SelectedDatabaseName, SelectedSchemaName, SelectedTableName) AS @QuoteIdentifier(BaseAlias)</strong>
                                <span>@FilteredStandaloneColumns.Count() base column(s)</span>
                            </div>
                            @if (SourceGroupExpanded)
                            {
                                <div class="bvg-output-grid">
                                    <div class="bvg-output-grid-header">Include</div>
                                    <div class="bvg-output-grid-header">Output Column</div>
                                    <div class="bvg-output-grid-header">Business Name</div>
                                    <div class="bvg-output-grid-header">Business Description</div>
                                    <div class="bvg-output-grid-header">Disable Inheritance</div>
                                    @foreach (var column in FilteredStandaloneColumns)
                                    {
                                        <div class="@ProjectionColumnRowClass(column)">
                                            <input type="checkbox" checked="@column.Include" @onchange="args => OnColumnIncludeChanged(column, args)" />
                                        </div>
                                        <div class="@ProjectionColumnRowClass(column)">
                                            <span class="bvg-output-expression">@BuildBaseProjectionText(column)</span>
                                            <span class="bvg-muted-cell">@ColumnKeyRoleLabel(column)</span>
                                        </div>
                                        <div class="@ProjectionColumnRowClass(column)">
                                            <input value="@column.BusinessName" @oninput="args => OnColumnBusinessNameChanged(column, args)" />
                                        </div>
                                        <div class="@ProjectionColumnRowClass(column)">
                                            <input value="@column.BusinessDescription" @oninput="args => OnColumnBusinessDescriptionChanged(column, args)" />
                                        </div>
                                        <div class="@ProjectionColumnRowClass(column)">
                                            <label class="bvg-system-check">
                                                <input type="checkbox" checked="@IsRelationshipColumn(column)" disabled />
                                                <span>System</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="bvg-projection-group">
                            <div class="bvg-group-heading">M-to-1 Lookup Relationships (@FilteredRelationships.Count())</div>
                            @foreach (var relationship in FilteredRelationships)
                            {
                                var joinSuppressed = IsJoinSuppressed(relationship);
                                var groupExpanded = IsRelationshipGroupExpanded(relationship);
                                <div class="@ProjectionRelationshipGroupClass(relationship)">
                                    <div class="bvg-group-header">
                                        <button type="button" class="bvg-group-toggle" @onclick="() => ToggleRelationshipGroup(relationship)">@(groupExpanded ? "▾" : "▸")</button>
                                        <span class="@RelationshipStatusClass(relationship)">@RelationshipStatusText(relationship)</span>
                                        @if (!joinSuppressed)
                                        {
                                            <input type="checkbox" checked="@relationship.Include" @onchange="args => OnRelationshipIncludeChanged(relationship, args)" disabled="@(!IncludeLookupDisplayColumns)" />
                                        }
                                        else
                                        {
                                            <span class="bvg-muted-cell">Suppressed</span>
                                        }
                                        <strong>@relationship.LocalColumns</strong>
                                        <span>@QualifiedName(SelectedDatabaseName, relationship.ReferencedSchemaName, relationship.ReferencedTableName)</span>
                                    </div>
                                    @if (groupExpanded)
                                    {
                                        <div class="bvg-join-preview">
                                            <span>Generated Join</span>
                                            <code>@BuildJoinText(relationship)</code>
                                        </div>

                                        @if (RelationshipOwnsProjectionColumns(relationship))
                                        {
                                            <div class="bvg-output-grid bvg-relationship-output-grid">
                                                <div class="bvg-output-grid-header">Include</div>
                                                <div class="bvg-output-grid-header">Output Column</div>
                                                <div class="bvg-output-grid-header">Business Name</div>
                                                <div class="bvg-output-grid-header">Business Description</div>
                                                <div class="bvg-output-grid-header">Disable Inheritance</div>
                                                @foreach (var column in GetRelationshipColumns(relationship))
                                                {
                                                    <div class="@ProjectionColumnRowClass(column)">
                                                        <input type="checkbox" checked="@column.Include" @onchange="args => OnColumnIncludeChanged(column, args)" disabled="@(!relationship.Include)" />
                                                    </div>
                                                    <div class="@ProjectionColumnRowClass(column)">
                                                        <span class="bvg-output-expression">@BuildBaseProjectionText(column)</span>
                                                        <span class="bvg-muted-cell">FK key carried from source table</span>
                                                    </div>
                                                    <div class="@ProjectionColumnRowClass(column)">
                                                        <input value="@column.BusinessName" @oninput="args => OnColumnBusinessNameChanged(column, args)" disabled="@(!relationship.Include)" />
                                                    </div>
                                                    <div class="@ProjectionColumnRowClass(column)">
                                                        <input value="@column.BusinessDescription" @oninput="args => OnColumnBusinessDescriptionChanged(column, args)" disabled="@(!relationship.Include)" />
                                                    </div>
                                                    <div class="@ProjectionColumnRowClass(column)">
                                                        <label class="bvg-system-check">
                                                            <input type="checkbox" checked disabled />
                                                            <span>System</span>
                                                        </label>
                                                    </div>
                                                }

                                                <div class="@ProjectionDisplayRowClass(relationship)">
                                                    <input type="checkbox" checked="@relationship.IncludeDisplayColumn" @onchange="args => OnRelationshipDisplayIncludeChanged(relationship, args)" disabled="@(!relationship.Include || string.IsNullOrWhiteSpace(relationship.DisplayColumnName))" />
                                                </div>
                                                <div class="@ProjectionDisplayRowClass(relationship)">
                                                    <span class="bvg-output-expression">@BuildDisplayProjectionText(relationship)</span>
                                                    <span class="bvg-muted-cell">Lookup display column</span>
                                                </div>
                                                <div class="@ProjectionDisplayRowClass(relationship)">
                                                    <input value="@relationship.DisplayBusinessName" @oninput="args => OnRelationshipDisplayBusinessNameChanged(relationship, args)" disabled="@(!relationship.Include || !relationship.IncludeDisplayColumn)" />
                                                </div>
                                                <div class="@ProjectionDisplayRowClass(relationship)">
                                                    <input value="@relationship.DisplayBusinessDescription" @oninput="args => OnRelationshipDisplayBusinessDescriptionChanged(relationship, args)" disabled="@(!relationship.Include || !relationship.IncludeDisplayColumn)" />
                                                </div>
                                                <div class="@ProjectionDisplayRowClass(relationship)">
                                                    <label class="bvg-system-check">
                                                        <input type="checkbox" checked disabled />
                                                        <span>System</span>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="bvg-tree-note">No display lookup is available; FK columns remain in the source table output and no join will be generated.</div>
                                        }
                                    }
                                </div>
                            }
                        </section>
                    </div>
                }
            </div>
            <footer class="bvg-workspace-actions">
                <button type="button" class="@RegenerateButtonClass" @onclick="RegenerateSql" disabled="@IsBusy">Regenerate SQL</button>
                <button type="button" class="bvg-button primary" @onclick="CopySqlAsync" disabled="@(!CanCopySql)">Copy SQL</button>
            </footer>
        </section>
    </div>
</div>

@code {
    private const string DefaultTargetDatabaseName = "VVGBI_Integrations";
    private const string DefaultTargetSchemaName = "dbo";
    private const string OutputShapeCte = "CTE";
    private const string OutputShapeStandard = "Standard";

    private bool IsBusy;
    private bool IncludeLookupDisplayColumns = true;
    private bool IgnoreSelfJoins = true;
    private bool IgnoreRelationshipsWithoutDisplay = true;
    private bool IncludeMetadataPlaceholders;
    private string OutputShape = OutputShapeCte;
    private string StatusMessage = "";
    private string RelationshipTelemetryMessage = "";
    private string SelectedDatabaseName = "";
    private string SelectedSchemaName = "";
    private string SelectedTableName = "";
    private string BaseAlias = "";
    private string TargetDatabaseName = DefaultTargetDatabaseName;
    private string TargetSchemaName = DefaultTargetSchemaName;
    private string TargetViewName = "";
    private string ColumnFilter = "";
    private string GeneratedSql = "";
    private string ActiveWorkspaceTab = "sql";
    private string ActiveSourceInfoTab = "options";
    private bool HighlightSqlPending;
    private bool SourceGroupExpanded = true;
    private int SqlRenderVersion;
    private bool SqlDirty;
    private HashSet<string> CollapsedRelationshipGroups = new(StringComparer.OrdinalIgnoreCase);

    private List<DatabaseDefinition> Databases = new();
    private List<TableSchemaColumnInfo> Columns = new();
    private List<TableSchemaRelationshipInfo> AllRelationships = new();
    private List<TableSchemaRelationshipInfo> Relationships = new();
    private List<TableSchemaChildRelationshipInfo> ChildRelationships = new();

    private bool CanRegenerateSql =>
        !IsBusy &&
        Columns.Count > 0 &&
        !string.IsNullOrWhiteSpace(SelectedDatabaseName) &&
        !string.IsNullOrWhiteSpace(SelectedSchemaName) &&
        !string.IsNullOrWhiteSpace(SelectedTableName) &&
        !string.IsNullOrWhiteSpace(BaseAlias) &&
        !string.IsNullOrWhiteSpace(TargetSchemaName) &&
        !string.IsNullOrWhiteSpace(TargetViewName);

    private bool CanCopySql =>
        !SqlDirty && !string.IsNullOrWhiteSpace(GeneratedSql);

    private string RegenerateButtonClass =>
        SqlDirty ? "bvg-button primary" : "bvg-button secondary";

    private string TargetViewPreview =>
        string.IsNullOrWhiteSpace(TargetViewName)
            ? "Select a table to generate a target view name."
            : $"CREATE OR ALTER VIEW {TargetViewNameSql}";

    private string TargetViewNameSql =>
        QualifiedName(TargetSchemaName, TargetViewName);

    private string SelectedTableDisplayName =>
        string.IsNullOrWhiteSpace(SelectedTableName)
            ? "the selected table"
            : QualifiedName(SelectedDatabaseName, SelectedSchemaName, SelectedTableName);

    private IEnumerable<TableSchemaColumnInfo> FilteredColumns =>
        string.IsNullOrWhiteSpace(ColumnFilter)
            ? Columns
            : Columns.Where(column => column.ColumnName.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase)
                                   || column.DataType.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase)
                                   || column.KeyRole.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TableSchemaColumnInfo> FilteredStandaloneColumns =>
        FilteredColumns.Where(column => !RelationshipOwnsColumn(column.ColumnName));

    private IEnumerable<TableSchemaRelationshipInfo> FilteredRelationships =>
        string.IsNullOrWhiteSpace(ColumnFilter)
            ? Relationships
            : Relationships.Where(RelationshipMatchesFilter);

    private string TabClass(string tabName) =>
        ActiveWorkspaceTab == tabName
            ? "bvg-tab active"
            : "bvg-tab";

    private string SourceInfoTabClass(string tabName) =>
        ActiveSourceInfoTab == tabName
            ? "bvg-mini-tab active"
            : "bvg-mini-tab";

    protected override async Task OnInitializedAsync()
    {
        await RunPageOperationAsync(async () =>
        {
            Databases = (await DatabaseRepository.GetAllAsync()).ToList();
            if (Databases.Count == 0)
            {
                StatusMessage = "No SchemaStudio database definitions are available.";
                return;
            }

            SelectDatabase(Databases[0].DatabaseName);
        }, "Failed to load databases.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HighlightSqlPending)
        {
            HighlightSqlPending = false;
            await JSRuntime.InvokeVoidAsync("highlightSql", 30);
        }
    }

    private void SetWorkspaceTab(string tabName)
    {
        ActiveWorkspaceTab = tabName;
        QueueSqlHighlight();
    }

    private void SetSourceInfoTab(string tabName)
    {
        ActiveSourceInfoTab = tabName;
    }

    private void ToggleSourceGroup()
    {
        SourceGroupExpanded = !SourceGroupExpanded;
    }

    private void ToggleRelationshipGroup(TableSchemaRelationshipInfo relationship)
    {
        var key = RelationshipGroupKey(relationship);
        if (!CollapsedRelationshipGroups.Add(key))
        {
            CollapsedRelationshipGroups.Remove(key);
        }
    }

    private void ExpandAllProjectionGroups()
    {
        SourceGroupExpanded = true;
        CollapsedRelationshipGroups.Clear();
    }

    private void CollapseAllProjectionGroups()
    {
        SourceGroupExpanded = false;
        CollapsedRelationshipGroups = Relationships
            .Select(RelationshipGroupKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool IsRelationshipGroupExpanded(TableSchemaRelationshipInfo relationship) =>
        !CollapsedRelationshipGroups.Contains(RelationshipGroupKey(relationship));

    private static string RelationshipGroupKey(TableSchemaRelationshipInfo relationship) =>
        string.IsNullOrWhiteSpace(relationship.ForeignKeyName)
            ? $"{relationship.ReferencedSchemaName}.{relationship.ReferencedTableName}.{relationship.LocalColumns}"
            : relationship.ForeignKeyName;

    private async Task OnDatabaseChangedAsync(object value)
    {
        SelectDatabase(value?.ToString() ?? "");
        await Task.CompletedTask;
    }

    private void SelectDatabase(string databaseName)
    {
        SelectedDatabaseName = databaseName;
        SelectedTableName = "";
        Columns.Clear();
        AllRelationships.Clear();
        Relationships.Clear();
        ChildRelationships.Clear();
        GeneratedSql = "";
        SqlDirty = false;
        RelationshipTelemetryMessage = "";
        StatusMessage = "";

        var selectedDatabase = Databases.FirstOrDefault(database => string.Equals(database.DatabaseName, SelectedDatabaseName, StringComparison.OrdinalIgnoreCase));
        SelectedSchemaName = string.IsNullOrWhiteSpace(selectedDatabase?.DefaultSchema)
            ? DefaultTargetSchemaName
            : selectedDatabase.DefaultSchema;

        StatusMessage = string.IsNullOrWhiteSpace(SelectedDatabaseName)
            ? "Select a source database."
            : $"Selected [{SelectedDatabaseName}].[{SelectedSchemaName}]. Type a table name and click Load.";
    }

    private void OnSchemaNameChanged(ChangeEventArgs args)
    {
        SelectedSchemaName = args.Value?.ToString()?.Trim() ?? "";
        SelectedTableName = "";
        Columns.Clear();
        AllRelationships.Clear();
        Relationships.Clear();
        ChildRelationships.Clear();
        GeneratedSql = "";
        SqlDirty = false;
        RelationshipTelemetryMessage = "";
        StatusMessage = string.IsNullOrWhiteSpace(SelectedSchemaName)
            ? "Select a source schema before loading a table."
            : $"Schema [{SelectedSchemaName}] selected. Type a table name and click Load.";
    }

    private void OnTableNameChanged(ChangeEventArgs args)
    {
        SelectedTableName = args.Value?.ToString()?.Trim() ?? "";
        BaseAlias = SelectedTableName;
        Columns.Clear();
        AllRelationships.Clear();
        Relationships.Clear();
        ChildRelationships.Clear();
        GeneratedSql = "";
        SqlDirty = false;
        RelationshipTelemetryMessage = "";
        TargetViewName = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedTableName)
            ? ""
            : $"SS_{SelectedDatabaseName}_{SelectedTableName}";
        StatusMessage = string.IsNullOrWhiteSpace(SelectedTableName)
            ? "Type a table name and click Load."
            : $"Ready to check [{SelectedDatabaseName}].[{SelectedSchemaName}].[{SelectedTableName}].";
    }

    private async Task LoadSelectedTableAsync()
    {
        BaseAlias = SelectedTableName;
        TargetViewName = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedTableName)
            ? ""
            : $"SS_{SelectedDatabaseName}_{SelectedTableName}";
        await LoadTableDetailsAsync();
    }

    private async Task RefreshMetadataAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedTableName))
        {
            StatusMessage = string.IsNullOrWhiteSpace(SelectedDatabaseName) || string.IsNullOrWhiteSpace(SelectedSchemaName)
                ? "Select a source database and schema, then type a table name."
                : $"Ready to check [{SelectedDatabaseName}].[{SelectedSchemaName}]. Type a table name and click Load.";
            return;
        }

        await LoadTableDetailsAsync();
    }

    private async Task LoadTableDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabaseName) ||
            string.IsNullOrWhiteSpace(SelectedSchemaName) ||
            string.IsNullOrWhiteSpace(SelectedTableName))
        {
            return;
        }

        await RunPageOperationAsync(async () =>
        {
            var details = await TableSchemaRepository.GetTableDetailsAsync(SelectedDatabaseName, SelectedSchemaName, SelectedTableName);
            Columns = details.Columns.ToList();
            AllRelationships = details.Relationships.ToList();
            ChildRelationships = details.ChildRelationships.ToList();
            ApplyRelationshipFilters();
            RegenerateSql();
            StatusMessage = BuildLoadedStatusMessage();
        }, $"Failed to load table details from [{SelectedDatabaseName}].[{SelectedSchemaName}].[{SelectedTableName}].");
    }

    private void ApplyRelationshipFilters()
    {
        var filteredRelationships = AllRelationships.AsEnumerable();

        if (IgnoreSelfJoins)
        {
            filteredRelationships = filteredRelationships.Where(relationship =>
                !string.Equals(relationship.ReferencedSchemaName, SelectedSchemaName, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(relationship.ReferencedTableName, SelectedTableName, StringComparison.OrdinalIgnoreCase));
        }

        Relationships = filteredRelationships.ToList();
        RelationshipTelemetryMessage = BuildRelationshipTelemetryMessage();
    }

    private void ApplyRelationshipFiltersAndMarkDirty()
    {
        ApplyRelationshipFilters();
        MarkSqlDirty();

        if (Columns.Count > 0)
        {
            StatusMessage = BuildLoadedStatusMessage();
        }
    }

    private void OnIncludeLookupDisplayColumnsChanged(ChangeEventArgs args)
    {
        IncludeLookupDisplayColumns = ToBool(args.Value);
        MarkSqlDirty();
    }

    private void OnIgnoreSelfJoinsChanged(ChangeEventArgs args)
    {
        IgnoreSelfJoins = ToBool(args.Value);
        ApplyRelationshipFiltersAndMarkDirty();
    }

    private void OnIgnoreRelationshipsWithoutDisplayChanged(ChangeEventArgs args)
    {
        IgnoreRelationshipsWithoutDisplay = ToBool(args.Value);
        ApplyRelationshipFiltersAndMarkDirty();
    }

    private void OnIncludeMetadataPlaceholdersChanged(ChangeEventArgs args)
    {
        IncludeMetadataPlaceholders = ToBool(args.Value);
        if (CanRegenerateSql)
        {
            RegenerateSql();
            return;
        }

        MarkSqlDirty();
    }

    private void OnOutputShapeChanged(ChangeEventArgs args)
    {
        OutputShape = args.Value?.ToString() == OutputShapeStandard
            ? OutputShapeStandard
            : OutputShapeCte;

        if (CanRegenerateSql)
        {
            RegenerateSql();
            return;
        }

        MarkSqlDirty();
    }

