@using System.Reflection
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using SchemaStudioWebViewer.Models
@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService
@inject TooltipService TooltipService

<style>
    .view-label-blue {
        color: var(--rz-primary) !important;
        font-weight: 400 !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 24px;
    }
</style>

<RadzenStack Gap="1rem" Style="padding: 10px; height: 80vh; overflow: hidden;">
    @if (Rows.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Light">
            @EmptyMessage
        </RadzenAlert>
    }
    else
    {
        <div style="flex: 1; min-height: 0;">
            <RadzenDataGrid Data="@Rows"
                            TItem="object"
                            AllowPaging="true"
                            PageSize="12"
                            AllowSorting="false"
                            AllowFiltering="false"
                            Density="Density.Compact"
                            Style="height:100%;"
                            RowDoubleClick="@(args => OpenRowDetails(args.Data))">
                <Columns>
                    @foreach (var prop in VisibleProperties)
                    {
                        <RadzenDataGridColumn TItem="object" Title="@GetColumnTitle(prop)">
                            <HeaderTemplate>
                                <div class="view-label-blue">
                                    @GetColumnTitle(prop)
                                    @if (!string.IsNullOrWhiteSpace(GetColumnDescription(prop)))
                                    {
                                        <RadzenIcon Icon="help_outline"
                                                    MouseEnter="@(args => TooltipService.Open(args, GetColumnDescription(prop)))" />
                                    }
                                </div>
                            </HeaderTemplate>
                            <Template Context="row">
                                @FormatValue(prop, row)
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</RadzenStack>

@code {
    [Parameter] public IEnumerable<object>? Items { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "No rows available.";

    private List<object> Rows { get; set; } = new();
    private List<PropertyInfo> VisibleProperties { get; set; } = new();
    private Type? ModelType => Rows.FirstOrDefault()?.GetType();

    protected override void OnParametersSet()
    {
        Rows = Items?.Where(x => x != null).ToList() ?? new List<object>();
        VisibleProperties = GetVisibleProperties().ToList();
    }

    private IEnumerable<PropertyInfo> GetVisibleProperties()
    {
        if (ModelType == null)
        {
            return Enumerable.Empty<PropertyInfo>();
        }

        return ModelType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Select(p => new
            {
                Property = p,
                Display = p.GetCustomAttribute<DisplayAttribute>(),
                DetailOnly = p.GetCustomAttribute<DetailViewOnlyAttribute>()
            })
            .Where(x =>
                x.Display != null &&
                x.Display.GetAutoGenerateField() != false &&
                (x.DetailOnly == null || x.DetailOnly.IsDetailOnly == false))
            .OrderBy(x => x.Display?.GetOrder() ?? 99)
            .Select(x => x.Property);
    }

    private static string FormatValue(PropertyInfo prop, object row)
    {
        var value = prop.GetValue(row);
        if (value == null)
        {
            return string.Empty;
        }

        return value switch
        {
            DateTime dateTime => dateTime.ToString("yyyy-MM-dd HH:mm"),
            bool boolean => boolean ? "Yes" : "No",
            _ => value.ToString() ?? string.Empty
        };
    }

    private static string GetColumnTitle(PropertyInfo prop)
    {
        return prop.GetCustomAttribute<DisplayAttribute>()?.Name
            ?? prop.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName
            ?? prop.Name;
    }

    private static string GetColumnDescription(PropertyInfo prop)
    {
        return prop.GetCustomAttribute<DescriptionAttribute>()?.Description
            ?? prop.GetCustomAttribute<DisplayAttribute>()?.Description
            ?? string.Empty;
    }

    private async Task OpenRowDetails(object row)
    {
        var rowLabel = ModelType?.Name ?? "Row";

        await DialogService.OpenAsync<DynamicDetailForm>(
            $"{rowLabel} Details",
            new Dictionary<string, object>
            {
                { "Model", row }
            },
            new DialogOptions
            {
                Width = "900px",
                Height = "800px",
                Resizable = true,
                Draggable = true
            });
    }
}
