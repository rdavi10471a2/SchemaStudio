@using Radzen
@using SchemaStudioWebViewer.WEBSemanticModel.Model
@using SchemaStudioWebViewer.WEBSemanticModel.Services
@inject DialogService DialogService
@inject IJSRuntime JSRuntime
@inject ViewParsingService ParserService

<div class="resolved-chain-dialog-root">
    <RadzenTabs class="resolved-chain-tabs"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex="SelectedTabIndex">
        <Tabs>
            <RadzenTabsItem Text="Dependencies">
                <div class="resolved-chain-layout">
                    <section class="chain-panel column-panel">
                        <header class="chain-panel-header">SELECT COLUMNS (@ColumnNodes.Count)</header>
                        <div class="chain-tree-wrap">
                            <RadzenTree Data="@ColumnNodes"
                                        Change="@OnTreeSelectionChanged"
                                        Style="height:100%; width:100%;">
                                <RadzenTreeLevel TextProperty="@nameof(ExplorerTreeNode.Text)"
                                                 ChildrenProperty="@nameof(ExplorerTreeNode.Children)"
                                                 HasChildren="@HasChildren"
                                                 Expanded="@IsExpanded">
                                    <Template Context="treeItem">
                                        @if (treeItem.Value is ExplorerTreeNode node)
                                        {
                                            @RenderNode(node)
                                        }
                                    </Template>
                                </RadzenTreeLevel>
                            </RadzenTree>
                        </div>
                    </section>

                    <section class="chain-panel source-panel">
                        <header class="chain-panel-header">FROM / JOIN SOURCES</header>
                        <div class="chain-tree-wrap">
                            <RadzenTree Data="@SourceNodes"
                                        Change="@OnTreeSelectionChanged"
                                        Style="height:100%; width:100%;">
                                <RadzenTreeLevel TextProperty="@nameof(ExplorerTreeNode.Text)"
                                                 ChildrenProperty="@nameof(ExplorerTreeNode.Children)"
                                                 HasChildren="@HasChildren"
                                                 Expanded="@IsExpanded">
                                    <Template Context="treeItem">
                                        @if (treeItem.Value is ExplorerTreeNode node)
                                        {
                                            @RenderNode(node)
                                        }
                                    </Template>
                                </RadzenTreeLevel>
                            </RadzenTree>
                        </div>
                    </section>

                    <aside class="chain-panel detail-panel">
                        <header class="chain-panel-header">@SelectedTitle</header>
                        <div class="detail-body">
                            @if (SelectedNode == null)
                            {
                                <div class="empty-detail">Select a column, inheritance node, lineage node, view, or table.</div>
                            }
                            else
                            {
                                <div class="detail-heading">
                                    @if (!string.IsNullOrWhiteSpace(SelectedNode.Badge))
                                    {
                                        <span class="node-badge @SelectedNode.BadgeClass">@SelectedNode.Badge</span>
                                    }
                                    <span>@SelectedNode.Text</span>
                                </div>

                                <div class="detail-scroll">
                                    @foreach (var detail in SelectedNode.Details)
                                    {
                                        <div class="detail-row">
                                            <span>@detail.Label</span>
                                            <strong>@detail.Value</strong>
                                        </div>
                                    }
                                </div>

                                @if (SelectedNode.Kind == TreeNodeKind.View)
                                {
                                    <div class="detail-actions">
                                        <RadzenButton Text="Show SQL"
                                                      Icon="code"
                                                      Size="ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Light"
                                                      Click="@ShowSelectedViewSqlAsync" />
                                    </div>
                                }
                            }
                        </div>
                    </aside>
                </div>
            </RadzenTabsItem>
            @foreach (var sqlTab in SqlTabs)
            {
                <RadzenTabsItem Text="@sqlTab.Title">
                    <div class="resolved-chain-sql-pane">
                        @if (sqlTab.CanClose)
                        {
                            <div class="sql-tab-actions">
                                <RadzenButton Text="Close Tab"
                                              Icon="close"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              Click="@(() => CloseSqlTab(sqlTab))" />
                            </div>
                        }
                        <div class="sql-code-container resolved-chain-sql">
                            <pre class="language-sql"><code class="language-sql">@sqlTab.Content</code></pre>
                        </div>
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>

    <div class="chain-dialog-actions">
        <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close())" />
    </div>
</div>

<style>
    .resolved-chain-dialog-root {
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: calc(100vh - 120px);
        overflow: hidden;
    }

    .resolved-chain-tabs {
        flex: 1;
        min-height: 0;
    }

    .resolved-chain-tabs .rz-tabview,
    .resolved-chain-tabs .rz-tabview-panels,
    .resolved-chain-tabs .rz-tabview-panel {
        height: 100%;
    }

    .resolved-chain-layout {
        display: grid;
        grid-template-columns: minmax(520px, 1fr) minmax(460px, 0.9fr);
        grid-template-rows: minmax(0, 1fr) minmax(0, 0.82fr);
        grid-template-areas:
            "columns details"
            "sources details";
        gap: 0.75rem;
        height: 100%;
        padding: 0.75rem;
        overflow: hidden;
    }

    .chain-panel {
        min-height: 0;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #fff;
        overflow: hidden;
    }

    .column-panel {
        grid-area: columns;
    }

    .source-panel {
        grid-area: sources;
    }

    .detail-panel {
        grid-area: details;
        display: flex;
        flex-direction: column;
    }

    .chain-panel-header {
        min-height: 36px;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid #e7ebf0;
        background: #f8f9fb;
        color: #1f2937;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .chain-tree-wrap {
        height: calc(100% - 36px);
        overflow: auto;
        padding: 0.45rem 0.35rem;
    }

    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content {
        min-height: 28px;
        border-radius: 4px;
        color: #1f2937;
    }

    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-highlight,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-highlight:hover,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-selected,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-selected:hover,
    .resolved-chain-dialog-root .rz-tree .rz-state-highlight,
    .resolved-chain-dialog-root .rz-tree .rz-state-highlight:hover,
    .resolved-chain-dialog-root .rz-tree .rz-state-selected,
    .resolved-chain-dialog-root .rz-tree .rz-state-selected:hover {
        background: #eef3ff !important;
        color: #1f2937 !important;
        box-shadow: inset 3px 0 0 var(--rz-primary);
    }

    .resolved-chain-dialog-root .rz-tree .rz-state-highlight *,
    .resolved-chain-dialog-root .rz-tree .rz-state-selected *,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-highlight *,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-selected * {
        color: #1f2937 !important;
    }

    .resolved-chain-dialog-root .rz-tree .rz-state-highlight .node-badge,
    .resolved-chain-dialog-root .rz-tree .rz-state-selected .node-badge,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-highlight .node-badge,
    .resolved-chain-dialog-root .rz-tree .rz-tree-item-content.rz-state-selected .node-badge {
        background: #f5f7ff !important;
        border-color: #d7ddff !important;
        color: var(--rz-primary) !important;
    }

    .tree-node-content {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-width: 0;
        max-width: 100%;
        color: #1f2937;
        line-height: 1.45;
    }

    .tree-node-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
    }

    .tree-node-secondary {
        color: #6b7280;
        font-size: 0.78rem;
        white-space: nowrap;
    }

    .node-badge {
        display: inline-flex;
        align-items: center;
        min-height: 18px;
        padding: 0 0.4rem;
        border: 1px solid #d7ddff;
        border-radius: 3px;
        background: #f5f7ff;
        color: var(--rz-primary);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .node-badge.lineage {
        border-color: #d9e7dc;
        background: #f4faf5;
        color: #2f7d46;
    }

    .node-badge.inheritance {
        border-color: #dde3ff;
        background: #f5f7ff;
        color: #335cff;
    }

    .node-badge.warning {
        border-color: #fde2a8;
        background: #fff8e6;
        color: #9a6500;
    }

    .detail-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        padding: 1rem;
    }

    .detail-heading {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid #e7ebf0;
        color: #111827;
        font-size: 1rem;
        font-weight: 700;
    }

    .detail-actions {
        flex: 0 0 auto;
        display: flex;
        justify-content: flex-end;
        padding: 0.75rem 0 0;
        border-top: 1px solid #e7ebf0;
    }

    .detail-scroll {
        flex: 1;
        min-height: 0;
        overflow: auto;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 1rem;
        padding: 0.78rem 0;
        border-bottom: 1px solid #eef0f3;
    }

    .detail-row span {
        color: #4b5563;
        font-size: 0.83rem;
    }

    .detail-row strong {
        min-width: 0;
        overflow-wrap: anywhere;
        color: #1f2937;
        font-size: 0.86rem;
        font-weight: 500;
    }

    .empty-detail {
        color: #6b7280;
        font-size: 0.9rem;
    }

    .resolved-chain-sql-pane {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        padding: 0.75rem;
        gap: 0.5rem;
    }

    .sql-tab-actions {
        flex: 0 0 auto;
        display: flex;
        justify-content: flex-end;
    }

    .resolved-chain-sql {
        flex: 1;
        min-height: 0;
        border: 1px solid #444;
        border-radius: 4px;
        overflow: auto;
        background: #111827;
    }

    .chain-dialog-actions {
        flex: 0 0 auto;
        display: flex;
        justify-content: flex-end;
        padding: 0.5rem 0.75rem 0.75rem;
    }
</style>

@code {
    [Parameter] public ParsedQuery? ParsedView { get; set; }
    [Parameter] public string SqlContent { get; set; } = string.Empty;
    [Parameter] public string SelectedViewName { get; set; } = string.Empty;

    private List<ExplorerTreeNode> ColumnNodes { get; set; } = new();
    private List<ExplorerTreeNode> SourceNodes { get; set; } = new();
    private List<SqlViewTab> SqlTabs { get; set; } = new();
    private ExplorerTreeNode? SelectedNode { get; set; }
    private int SelectedTabIndex { get; set; }

    private string SelectedTitle => SelectedNode?.Kind switch
    {
        TreeNodeKind.Column => "Selected Column",
        TreeNodeKind.Inheritance => "Inheritance",
        TreeNodeKind.Lineage => "Physical Lineage",
        TreeNodeKind.View => "Selected View",
        TreeNodeKind.Table => "Selected Table",
        _ => "Details"
    };

    protected override void OnParametersSet()
    {
        ColumnNodes = BuildColumnNodes(ParsedView?.Columns ?? new List<ViewSourcedColumnDefinition>());
        SourceNodes = BuildSourceNodes(ParsedView?.SourceTables ?? new List<SourceTable>());
        EnsureInitialSqlTab();
        SelectedNode ??= ColumnNodes.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(SqlContent))
        {
            await JSRuntime.InvokeVoidAsync("highlightSql", 30);
        }
    }

    private RenderFragment RenderNode(ExplorerTreeNode node) => @<div class="tree-node-content" title="@node.Tooltip">
        @if (!string.IsNullOrWhiteSpace(node.Badge))
        {
            <span class="node-badge @node.BadgeClass">@node.Badge</span>
        }
        <span class="tree-node-text">@node.Text</span>
        @if (!string.IsNullOrWhiteSpace(node.SecondaryText))
        {
            <span class="tree-node-secondary">@node.SecondaryText</span>
        }
    </div>;

    private static bool HasChildren(object value) =>
        value is ExplorerTreeNode node && node.Children.Count > 0;

    private static bool IsExpanded(object value) =>
        value is ExplorerTreeNode node && node.Expanded;

    private void OnTreeSelectionChanged(TreeEventArgs args)
    {
        if (args.Value is ExplorerTreeNode node)
        {
            SelectedNode = node;
        }
    }

    private async Task ShowSelectedViewSqlAsync()
    {
        if (SelectedNode?.Kind != TreeNodeKind.View)
        {
            return;
        }

        var sql = ParserService.GetViewSql(
            SelectedNode.Database,
            SelectedNode.Schema,
            SelectedNode.ObjectName);

        var key = FormatQualifiedName(SelectedNode.Database, SelectedNode.Schema, SelectedNode.ObjectName);
        var title = string.IsNullOrWhiteSpace(SelectedNode.ObjectName)
            ? "SQL"
            : $"SQL - {SelectedNode.ObjectName}";

        var tabIndex = SqlTabs.FindIndex(tab => string.Equals(tab.Key, key, StringComparison.OrdinalIgnoreCase));
        if (tabIndex < 0)
        {
            SqlTabs.Add(new SqlViewTab(key, title, sql ?? string.Empty, true));
            tabIndex = SqlTabs.Count - 1;
        }

        SelectedTabIndex = tabIndex + 1;
        await InvokeAsync(StateHasChanged);
        await JSRuntime.InvokeVoidAsync("highlightSql", 30);
    }

    private void EnsureInitialSqlTab()
    {
        if (SqlTabs.Count > 0 || string.IsNullOrWhiteSpace(SqlContent))
        {
            return;
        }

        SqlTabs.Add(new SqlViewTab("selected-view", "View SQL", SqlContent, false));
    }

    private void CloseSqlTab(SqlViewTab tab)
    {
        if (!tab.CanClose)
        {
            return;
        }

        var tabIndex = SqlTabs.IndexOf(tab);
        if (tabIndex < 0)
        {
            return;
        }

        SqlTabs.RemoveAt(tabIndex);

        if (SelectedTabIndex == tabIndex + 1)
        {
            SelectedTabIndex = 1;
        }
        else if (SelectedTabIndex > tabIndex + 1)
        {
            SelectedTabIndex--;
        }
    }

    private static List<ExplorerTreeNode> BuildColumnNodes(IEnumerable<ViewSourcedColumnDefinition> columns)
    {
        return columns
            .OrderBy(column => column.OrdinalPosition)
            .Select(column =>
            {
                var node = new ExplorerTreeNode(TreeNodeKind.Column, column.ColumnName)
                {
                    Tooltip = column.ColumnName,
                    Expanded = false
                };

                AddDetail(node, "Column", column.ColumnName);
                AddDetail(node, "Ordinal", column.OrdinalPosition.ToString());
                AddDetail(node, "Semantic Source", FormatQualifiedName(column.SemanticDatabase, column.SemanticSchema, column.SemanticObject, column.SemanticColumn));
                AddDetail(node, "Physical Lineage", FormatQualifiedName(column.BaseDatabase, column.BaseSchema, column.BaseTable, column.BaseColumn));
                AddDetail(node, "Inheritance", column.DisableInheritance ? "Disabled for this column" : "Allowed");

                var semanticSource = FormatQualifiedName(column.SemanticDatabase, column.SemanticSchema, column.SemanticObject, column.SemanticColumn);
                if (!string.IsNullOrWhiteSpace(semanticSource))
                {
                    node.Children.Add(new ExplorerTreeNode(TreeNodeKind.Inheritance, semanticSource)
                    {
                        Badge = "Inherits",
                        BadgeClass = "inheritance",
                        Tooltip = semanticSource,
                        Details =
                        {
                            new DetailRow("Column", column.ColumnName),
                            new DetailRow("Semantic Source", semanticSource),
                            new DetailRow("Inheritance", column.DisableInheritance ? "Disabled" : "Allowed")
                        }
                    });
                }

                var physicalLineage = FormatQualifiedName(column.BaseDatabase, column.BaseSchema, column.BaseTable, column.BaseColumn);
                if (!string.IsNullOrWhiteSpace(physicalLineage))
                {
                    node.Children.Add(new ExplorerTreeNode(TreeNodeKind.Lineage, physicalLineage)
                    {
                        Badge = "Lineage",
                        BadgeClass = "lineage",
                        Tooltip = physicalLineage,
                        Details =
                        {
                            new DetailRow("Column", column.ColumnName),
                            new DetailRow("Physical Lineage", physicalLineage)
                        }
                    });
                }

                if (node.Children.Count == 0)
                {
                    node.SecondaryText = "no semantic source or physical lineage";
                }

                return node;
            })
            .ToList();
    }

    private static List<ExplorerTreeNode> BuildSourceNodes(IEnumerable<SourceTable> sources)
    {
        return sources
            .Where(source => source.Kind != SourceKind.DerivedQuery && !string.IsNullOrWhiteSpace(source.Table))
            .OrderBy(source => source.ResolvedOrder)
            .Select(BuildSourceNode)
            .ToList();
    }

    private static ExplorerTreeNode BuildSourceNode(SourceTable source)
    {
        var objectName = FormatQualifiedName(source.Database, source.Schema, source.Table);
        var isView = source.NestedQuery != null;
        var node = new ExplorerTreeNode(isView ? TreeNodeKind.View : TreeNodeKind.Table, objectName)
        {
            Badge = isView ? "View" : "Table",
            BadgeClass = isView ? "inheritance" : string.Empty,
            Tooltip = objectName,
            Expanded = false
        };

        node.Database = source.Database ?? string.Empty;
        node.Schema = source.Schema ?? string.Empty;
        node.ObjectName = source.Table ?? string.Empty;

        AddDetail(node, "Object", objectName);
        AddDetail(node, "Join Type", source.JoinType);
        AddDetail(node, "Join", source.JoinExpression);

        if (source.NestedQuery != null)
        {
            node.Children.AddRange(BuildSourceNodes(source.NestedQuery.SourceTables));
        }

        return node;
    }

    private static void AddDetail(ExplorerTreeNode node, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            node.Details.Add(new DetailRow(label, value));
        }
    }

    private static string FormatQualifiedName(params string?[] parts) =>
        string.Join(".", parts.Where(part => !string.IsNullOrWhiteSpace(part)));

    private enum TreeNodeKind
    {
        Column,
        Inheritance,
        Lineage,
        View,
        Table
    }

    private sealed class ExplorerTreeNode
    {
        public ExplorerTreeNode(TreeNodeKind kind, string text)
        {
            Kind = kind;
            Text = text;
        }

        public TreeNodeKind Kind { get; }
        public string Text { get; }
        public string SecondaryText { get; set; } = string.Empty;
        public string Badge { get; set; } = string.Empty;
        public string BadgeClass { get; set; } = string.Empty;
        public string Tooltip { get; set; } = string.Empty;
        public bool Expanded { get; set; }
        public string Database { get; set; } = string.Empty;
        public string Schema { get; set; } = string.Empty;
        public string ObjectName { get; set; } = string.Empty;
        public List<ExplorerTreeNode> Children { get; } = new();
        public List<DetailRow> Details { get; init; } = new();
    }

    private sealed record DetailRow(string Label, string Value);

    private sealed record SqlViewTab(string Key, string Title, string Content, bool CanClose);
}
