@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Radzen.Blazor
@using SchemaStudio.AIHelpers
@using SchemaStudioWebViewer.Configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@attribute [FileVersion("1.2")]
@attribute [AIChange("1.2", "2026-04-27 11:32 AM CDT gated the layout hamburger and sidebar menu behind the temporary session auth flag so direct Home navigation cannot expose navigation before login.", AICommandStatus.Pending)]
@attribute [AIFileContext("Components/Layout/MainLayout.razor", "Hosts the shared Radzen application shell, navigation header/sidebar chrome, dialog providers, kiosk chrome suppression, and temporary simple-auth menu gating until real authentication is implemented.")]
@attribute [AIChange("1.1", "2026-04-22 06:04 PM CDT kept Radzen dialog providers in the page circuit so DialogService calls render shared dialogs.", AICommandStatus.Pending)]
@attribute [AIChange("1.0", "2026-04-22 11:06 AM CDT added config-driven kiosk chrome suppression for the /kiosk route.", AICommandStatus.Pending)]

<RadzenComponents />

<style>
    :root {
        --rz-layout-body-background: #f4f6f9;
    }

    /* Kill the rainbow gradient */
    .rz-layout, .rz-body {
        background-image: none !important;
        background-color: #f4f6f9 !important;
    }

        /* The white card container for the main content */
        .rz-body > .rz-p-4 {
            background-color: #ffffff !important;
            min-height: calc(100vh - 100px);
            border-radius: 8px;
            margin: 1rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border: 1px solid var(--rz-divider);
        }

    .kiosk-shell .rz-body > .rz-p-4 {
        min-height: calc(100vh - 2rem);
    }

    .rz-sidebar {
        background-color: #26272b !important;
        transition: width 0.3s ease-in-out;
    }

    /* Utility to fix your alignment frustration */
    .align-header {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
    }
</style>

<RadzenLayout Class="@LayoutClass" Style="@LayoutStyle">
    @* 2026-04-27 11:32 AM CDT AI v1.2 layout-auth marker: the sidebar toggle checks session auth before opening so debug-filled credentials alone cannot expose navigation. *@
    @* 2026-04-22 06:04 PM CDT AI v1.1 dialog-provider marker: RadzenComponents stays in the active page circuit so dialogs, notifications, tooltips, and context menus share the caller's services. *@
    @* 2026-04-22 11:06 AM CDT AI v1.0 kiosk layout marker: config can hide navigation chrome for /kiosk while Home remains the shared content surface. *@
    @if (!HideNavigationChrome)
    {
        <RadzenHeader>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenSidebarToggle Click="@ToggleSidebarAsync" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0 rz-ml-2">Schema Studio Web</RadzenText>
            </RadzenStack>
        </RadzenHeader>

        <RadzenSidebar @bind-Expanded="@sidebarExpanded"
                       Responsive="false"
                       Style="@(CanShowNavigationMenu && sidebarExpanded ? "width: 250px;" : "width: 0px; overflow: hidden;")">
            <RadzenStack Gap="0" class="rz-py-4 rz-ph-4">
                @if (CanShowNavigationMenu)
                {
                    <NavMenu />
                }
            </RadzenStack>
        </RadzenSidebar>
    }

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    bool sidebarExpanded = false;
    private bool isNavigationAuthenticated = false;

    private const string AuthStorageKey = "simpleAuth";
    private const string AuthenticatedValue = "true";

    private bool IsKioskRoute =>
        AppConfig.Current.Kiosk.Enabled &&
        string.Equals(CurrentRelativePath, AppConfig.Current.Kiosk.Route.Trim('/'), StringComparison.OrdinalIgnoreCase);

    private bool ShouldGateNavigationMenu =>
        AppConfig.Current.Auth.Enabled &&
        AppConfig.Current.Auth.RequireLoginForHome;

    private bool CanShowNavigationMenu =>
        !ShouldGateNavigationMenu ||
        isNavigationAuthenticated;

    private bool HideNavigationChrome =>
        IsKioskRoute &&
        AppConfig.Current.Kiosk.HideNavigationChrome;

    private string LayoutClass => HideNavigationChrome ? "kiosk-shell" : string.Empty;

    private string LayoutStyle => HideNavigationChrome
        ? "grid-template-areas: 'rz-body'; grid-template-columns: 1fr; height: 100vh;"
        : "grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body'; height: 100vh;";

    private string CurrentRelativePath
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var queryIndex = relative.IndexOf('?', StringComparison.Ordinal);
            return (queryIndex >= 0 ? relative[..queryIndex] : relative).Trim('/');
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshNavigationAuthStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleSidebarAsync()
    {
        await RefreshNavigationAuthStateAsync();

        if (!CanShowNavigationMenu)
        {
            sidebarExpanded = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        sidebarExpanded = !sidebarExpanded;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        InvokeAsync(async () =>
        {
            await RefreshNavigationAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshNavigationAuthStateAsync()
    {
        if (!ShouldGateNavigationMenu)
        {
            isNavigationAuthenticated = true;
            return;
        }

        var authValue = await JSRuntime.InvokeAsync<string>("authStateManager.load", AuthStorageKey);
        isNavigationAuthenticated = string.Equals(authValue, AuthenticatedValue, StringComparison.OrdinalIgnoreCase);

        if (!isNavigationAuthenticated)
        {
            sidebarExpanded = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
