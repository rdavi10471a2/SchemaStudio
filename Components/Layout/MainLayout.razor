@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Radzen.Blazor
@using SchemaStudio.AIHelpers
@using SchemaStudioWebViewer.Configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

@attribute [FileVersion("1.8")]
@attribute [AIChange(
    "1.8",
    "2026-04-30 11:10 PM CDT collapsed the duplicated shared body gutters so page surfaces start closer to the app chrome while preserving the bounded scroll host.",
    AICommandStatus.Pending)]
@attribute [AIChange(
    "1.7",
    "2026-04-30 10:58 PM CDT flattened the shared body wrapper and tightened the application header so pages do not inherit an extra framed shell or oversized app bar.",
    AICommandStatus.Pending)]
@attribute [AIChange("1.6", "2026-04-30 03:09 PM CDT restored scrolling on the bounded content card so pages can grow internally while still staying inside the viewport shell.", AICommandStatus.Pending)]
@attribute [AIChange("1.5", "2026-04-30 02:49 PM CDT tightened the shared Radzen body shell so page content stays inside the viewport card and feature pages own their internal scroll regions.", AICommandStatus.Pending)]
@attribute [AIChange("1.4", "2026-04-30 04:17 PM CDT bounded the shared layout body to viewport-relative height so pages can use internal scrolling instead of growing past the visible app shell.", AICommandStatus.Pending)]
@attribute [AIChange("1.3", "2026-04-27 11:36 AM CDT added a login-required toast when the guarded hamburger is clicked before the temporary session login is complete.", AICommandStatus.Pending)]
@attribute [AIChange("1.2", "2026-04-27 11:32 AM CDT gated the layout hamburger and sidebar menu behind the temporary session auth flag so direct Home navigation cannot expose navigation before login.", AICommandStatus.Pending)]
@attribute [AIFileContext("Components/Layout/MainLayout.razor", "Hosts the shared Radzen application shell, navigation header/sidebar chrome, dialog providers, kiosk chrome suppression, and temporary simple-auth menu gating until real authentication is implemented.")]
@attribute [AIChange("1.1", "2026-04-22 06:04 PM CDT kept Radzen dialog providers in the page circuit so DialogService calls render shared dialogs.", AICommandStatus.Pending)]
@attribute [AIChange("1.0", "2026-04-22 11:06 AM CDT added config-driven kiosk chrome suppression for the /kiosk route.", AICommandStatus.Pending)]

<RadzenComponents />

<style>
    :root {
        --rz-layout-body-background: #f4f6f9;
    }

    /* Kill the rainbow gradient */
    .rz-layout, .rz-body {
        background-image: none !important;
        background-color: #f4f6f9 !important;
    }

    .rz-layout {
        overflow: hidden !important;
    }

    .rz-body {
        min-height: 0 !important;
        overflow: hidden !important;
        padding: 0.55rem 0.75rem !important;
        box-sizing: border-box;
    }

        /* Keep the viewport-bounded scroll host without adding a second visual page frame. */
        .rz-body > .rz-p-4 {
            background-color: transparent !important;
            height: 100%;
            max-height: 100%;
            min-height: 0;
            overflow: auto;
            box-sizing: border-box;
            padding: 0 !important;
            border-radius: 0;
            margin: 0;
            box-shadow: none;
            border: 0;
        }

    .kiosk-shell .rz-body > .rz-p-4 {
        height: 100vh;
        max-height: 100vh;
        min-height: 0;
    }

    .rz-header {
        min-height: 42px !important;
        height: 42px !important;
    }

    .rz-header .rz-stack {
        min-height: 42px;
        height: 42px;
    }

    .rz-header .rz-sidebar-toggle {
        min-height: 42px;
        height: 42px;
        width: 42px;
    }

    .rz-header .rz-text {
        font-size: 1.05rem;
        line-height: 1.2;
    }

    .rz-sidebar {
        background-color: #26272b !important;
        transition: width 0.3s ease-in-out;
    }

    /* Utility to fix your alignment frustration */
    .align-header {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
    }
</style>

<RadzenLayout Class="@LayoutClass" Style="@LayoutStyle">
    @* 2026-04-30 03:09 PM CDT AI v1.6 layout-height marker: the bounded white content card scrolls again when a page legitimately grows inside the viewport. *@
    @* 2026-04-30 02:49 PM CDT AI v1.5 layout-height marker: Radzen body scrolling is suppressed so bounded pages do not escape the viewport card. *@
    @* 2026-04-30 04:17 PM CDT AI v1.4 layout-height marker: page content is viewport-bounded so feature pages can own local scroll regions. *@
    @* 2026-04-27 11:36 AM CDT AI v1.3 layout-auth marker: unauthenticated hamburger clicks now explain that login is required instead of silently doing nothing. *@
    @* 2026-04-27 11:32 AM CDT AI v1.2 layout-auth marker: the sidebar toggle checks session auth before opening so debug-filled credentials alone cannot expose navigation. *@
    @* 2026-04-22 06:04 PM CDT AI v1.1 dialog-provider marker: RadzenComponents stays in the active page circuit so dialogs, notifications, tooltips, and context menus share the caller's services. *@
    @* 2026-04-22 11:06 AM CDT AI v1.0 kiosk layout marker: config can hide navigation chrome for /kiosk while Home remains the shared content surface. *@
    @if (!HideNavigationChrome)
    {
        <RadzenHeader>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <RadzenSidebarToggle Click="@ToggleSidebarAsync" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0 rz-ml-2">Schema Studio Web  -- Schema & Understanding Service</RadzenText>
            </RadzenStack>
        </RadzenHeader>

        <RadzenSidebar @bind-Expanded="@sidebarExpanded"
                       Responsive="false"
                       Style="@(CanShowNavigationMenu && sidebarExpanded ? "width: 250px;" : "width: 0px; overflow: hidden;")">
            <RadzenStack Gap="0" class="rz-py-4 rz-ph-4">
                @if (CanShowNavigationMenu)
                {
                    <NavMenu />
                }
            </RadzenStack>
        </RadzenSidebar>
    }

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    bool sidebarExpanded = false;
    private bool isNavigationAuthenticated = false;

    private const string AuthStorageKey = "simpleAuth";
    private const string AuthenticatedValue = "true";

    private bool IsKioskRoute =>
        AppConfig.Current.Kiosk.Enabled &&
        string.Equals(CurrentRelativePath, AppConfig.Current.Kiosk.Route.Trim('/'), StringComparison.OrdinalIgnoreCase);

    private bool ShouldGateNavigationMenu =>
        AppConfig.Current.Auth.Enabled &&
        AppConfig.Current.Auth.RequireLoginForHome;

    private bool CanShowNavigationMenu =>
        !ShouldGateNavigationMenu ||
        isNavigationAuthenticated;

    private bool HideNavigationChrome =>
        IsKioskRoute &&
        AppConfig.Current.Kiosk.HideNavigationChrome;

    private string LayoutClass => HideNavigationChrome ? "kiosk-shell" : string.Empty;

    private string LayoutStyle => HideNavigationChrome
        ? "grid-template-areas: 'rz-body'; grid-template-columns: 1fr; height: 100vh;"
        : "grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body'; grid-template-rows: 42px minmax(0, 1fr); height: 100vh;";

    private string CurrentRelativePath
    {
        get
        {
            var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var queryIndex = relative.IndexOf('?', StringComparison.Ordinal);
            return (queryIndex >= 0 ? relative[..queryIndex] : relative).Trim('/');
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshNavigationAuthStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleSidebarAsync()
    {
        await RefreshNavigationAuthStateAsync();

        if (!CanShowNavigationMenu)
        {
            sidebarExpanded = false;
            NotificationService.Notify(NotificationSeverity.Info, "Login required", "Log in before opening navigation.", 2500);
            await InvokeAsync(StateHasChanged);
            return;
        }

        sidebarExpanded = !sidebarExpanded;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        InvokeAsync(async () =>
        {
            await RefreshNavigationAuthStateAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshNavigationAuthStateAsync()
    {
        if (!ShouldGateNavigationMenu)
        {
            isNavigationAuthenticated = true;
            return;
        }

        var authValue = await JSRuntime.InvokeAsync<string>("authStateManager.load", AuthStorageKey);
        isNavigationAuthenticated = string.Equals(authValue, AuthenticatedValue, StringComparison.OrdinalIgnoreCase);

        if (!isNavigationAuthenticated)
        {
            sidebarExpanded = false;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
