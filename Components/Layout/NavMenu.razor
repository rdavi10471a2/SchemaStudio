@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Routing

<RadzenPanelMenu Style="width: 100%;">
    @* 2026-04-15 03:10 PM CDT AI parser nav marker: add a dedicated parser sandbox entry instead of keeping parser experiments on Home. *@
    <RadzenPanelMenuItem Text="Schema Explorer"
                         Icon="explore"
                         Path="/"
                         Match="NavLinkMatch.All" />

    <RadzenPanelMenuItem Text="Parser Test Area"
                         Icon="account_tree"
                         Path="/parser-lab" />

    @* 2026-04-23 01:29 PM CDT AI manage-views nav marker: expose the new RHS-first view editing workspace from the main navigation. *@
    <RadzenPanelMenuItem Text="Manage Views"
                         Icon="view_sidebar"
                         Path="/manage-views" />

    @* 2026-04-30 04:02 PM CDT AI nav marker: expose the isolated Manage Views prototype route for side-by-side testing before it replaces the current page. *@
    <RadzenPanelMenuItem Text="Manage Views Next"
                         Icon="view_week"
                         Path="/manage-views-next" />

    <RadzenPanelMenuItem Text="Manage Databases"
                         Icon="database"
                         Path="/manage-databases" />

    <RadzenPanelMenuItem Text="Help Editor"
                         Icon="settings_applications"
                         Path="/help-editor" />
</RadzenPanelMenu>
